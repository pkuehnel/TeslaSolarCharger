@using TeslaSolarCharger.Shared.Localization
@using TeslaSolarCharger.Shared.Localization.Contracts
@using TeslaSolarCharger.Shared.Localization.Registries.Components

@inject ITextLocalizationService TextLocalizer

<MudDialog>
    <DialogContent>
        @string.Format(T(TranslationKeys.DeleteDialogContentFormat), ElementName)
        @if (RequiresNameConfirmation)
        {
            <MudAlert Severity="Severity.Warning" Class="my-3">
                @string.Format(T(TranslationKeys.DeleteDialogConfirmationPromptFormat), ConfirmationName)
            </MudAlert>
            <GenericInput T="string"
                          For="() => ConfirmationInput"
                          LabelName="@T(TranslationKeys.DeleteDialogConfirmationLabel)"
                          ImmediateValueUpdate="true"
                          OnValueChanged="@(_ => StateHasChanged())" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@T(TranslationKeys.DeleteDialogCancel)</MudButton>
        <MudButton Color="Color.Error" OnClick="Submit" Disabled="@(!CanConfirm)">@T(TranslationKeys.DeleteDialogConfirm)</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string ElementName { get; set; } = "";

    /// <summary>
    /// When set to a non-empty value the user has to type this exact text before the delete can be confirmed.
    /// Leave null/empty to keep the plain confirmation behaviour used by other callers.
    /// </summary>
    [Parameter]
    public string? ConfirmationName { get; set; }

    // GenericInput binds to a property (not a field) via its For expression, so this must stay a property.
    public string ConfirmationInput { get; set; } = "";

    private bool RequiresNameConfirmation => !string.IsNullOrEmpty(ConfirmationName);

    private bool CanConfirm => !RequiresNameConfirmation
                               || string.Equals(ConfirmationInput.Trim(), ConfirmationName, StringComparison.Ordinal);

    private string T(string key) =>
        TextLocalizer.Get<DialogsLocalizationRegistry>(key)
        ?? key;

    void Submit()
    {
        if (!CanConfirm)
        {
            return;
        }
        MudDialog.Close(DialogResult.Ok(true));
    }

    void Cancel() => MudDialog.Cancel();
}
