@using System.Globalization
@using MudBlazor
@using PkSoftwareService.Custom.Backend.Ble
@using TeslaSolarCharger.Client.Components.StartPage
@using TeslaSolarCharger.Client.Helper.Contracts
@using TeslaSolarCharger.Client.Services.Contracts
@using TeslaSolarCharger.Shared.Dtos
@using TeslaSolarCharger.Client.Wrapper
@using TeslaSolarCharger.Shared.Enums
@using TeslaSolarCharger.Shared.Localization
@using TeslaSolarCharger.Shared.Localization.Contracts
@using TeslaSolarCharger.Shared.Localization.Registries
@using TeslaSolarCharger.Shared.Localization.Registries.Pages
@using TeslaSolarCharger.Shared.Resources.Contracts

@inject ITextLocalizationService TextLocalizer
@inject IConstants Constants
@inject ISnackbar Snackbar
@inject ICarSettingsService CarSettingsService
@inject IHomeService HomeService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IHttpClientHelper HttpClientHelper

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Class="mr-3 mb-n1" />
            @T(TranslationKeys.CarsTitle)
        </MudText>
    </TitleContent>
    <DialogContent>
        <div style="max-height: 70vh; overflow-y: auto; overflow-x: hidden;">
            @if (_showFleetApiTest)
            {
                <MudText Typo="Typo.subtitle1" GutterBottom="true">@T(TranslationKeys.CarEditFleetApiTestTitle)</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">@T(TranslationKeys.CarEditFleetApiTestHint)</MudText>
                <FleetApiTestComponent CarId="Car.Item.Id" AutoTest="true" />
            }
            else
            {
            <EditFormComponent T="CarBasicConfiguration" WrappedElement="Car"
                               HideSubmitButton="true" @ref="_editForm">
                
                <GenericInput For="() => Car.Item.Name" />
                <GenericInput For="() => Car.Item.Vin"
                              IsDisabledParameter="@(Car.Item.CarType == CarType.Tesla)" />
                <GenericInput T="bool"
                              For="() => Car.Item.ShouldBeManaged"
                              OnValueChanged="_ => StateHasChanged()" />

                @if (Car.Item.ShouldBeManaged)
                {
                    <div class="mt-4 p-3 border rounded">
                        <MudText Typo="Typo.subtitle1" GutterBottom="true">@T(TranslationKeys.CarEditManagementSettings)</MudText>
                        
                        @if (Car.Item.CarType != CarType.Tesla && Car.Item.MinimumAmpere < 6)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mb-4">
                                <h5>@T(TranslationKeys.CarSettingsCurrentBelow6AWarningTitle)</h5>
                                @T(TranslationKeys.CarSettingsCurrentBelow6AWarningContent)
                            </MudAlert>
                        }

                        <GenericInput For="() => Car.Item.MinimumAmpere" />
                        @if (Car.Item.CarType == CarType.Tesla)
                        {
                            <GenericInput For="() => Car.Item.SwitchOffAtCurrent"></GenericInput>
                            <GenericInput For="() => Car.Item.SwitchOnAtCurrent"></GenericInput>
                        }

                        <GenericInput For="() => Car.Item.MaximumAmpere" />
                        @if (Car.Item.CarType != CarType.Tesla)
                        {
                            <GenericInput For="() => Car.Item.MaximumPhases" />
                        }

                        <GenericInput For="() => Car.Item.UsableEnergy" />
                        <GenericInput For="() => Car.Item.ChargingPriority" />
                    </div>

                    @if (Car.Item.CarType == CarType.Tesla)
                    {
                        <div class="mt-4 p-3 border rounded">
                            <MudText Typo="Typo.subtitle1" GutterBottom="true">@T(TranslationKeys.CarEditTeslaSpecific)</MudText>
                            
                            <GenericInput T="bool"
                                          For="() => Car.Item.UseBle"
                                          OnValueChanged="newValue => { OnUseBleChanged(newValue); Car.ClearErrors(nameof(Car.Item.BleApiBaseUrl), nameof(Car.Item.UseFleetTelemetry), nameof(Car.Item.HomeDetectionVia)); StateHasChanged(); }" />
                            @if (Car.Item.UseBle)
                            {
                                <GenericInput T="string"
                                              For="() => Car.Item.BleApiBaseUrl"
                                              OnValueChanged="@((string _) => LoadBleAdaptersAsync())" />
                                <div class="px-2 pt-2">
                                    <MudSelect T="string"
                                               Value="@(Car.Item.BleAdapterAddress ?? string.Empty)"
                                               ValueChanged="@(value => Car.Item.BleAdapterAddress = string.IsNullOrEmpty(value) ? null : value)"
                                               Variant="Variant.Outlined"
                                               Label="@T(TranslationKeys.CarSettingsBleAdapterLabel)"
                                               HelperText="@T(TranslationKeys.CarSettingsBleAdapterHelperText)"
                                               Margin="Constants.InputMargin"
                                               Adornment="@(_isLoadingBleAdapters ? Adornment.End : Adornment.None)"
                                               AdornmentIcon="@Icons.Material.Filled.HourglassEmpty">
                                        <MudSelectItem T="string" Value="@string.Empty">@T(TranslationKeys.CarSettingsBleAdapterContainerDefault)</MudSelectItem>
                                        @foreach (var adapter in _bleAdapters)
                                        {
                                            <MudSelectItem T="string" Value="@adapter.StableId">@GetAdapterDisplayName(adapter)</MudSelectItem>
                                        }
                                        @* An adapter that is configured but currently not listed (container offline or
                                           adapter unplugged) must stay selectable, otherwise opening the dialog would
                                           silently reset the car to the container's default radio. *@
                                        @if (!string.IsNullOrEmpty(Car.Item.BleAdapterAddress)
                                             && _bleAdapters.All(a => a.StableId != Car.Item.BleAdapterAddress))
                                        {
                                            <MudSelectItem T="string" Value="@Car.Item.BleAdapterAddress">
                                                @Format(TranslationKeys.CarSettingsBleAdapterMissingFormat, Car.Item.BleAdapterAddress)
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                </div>
                            }

                            <div class="px-2 pt-2">
                                <MudSelect T="HomeDetectionVia"
                                           For="() => Car.Item.HomeDetectionVia"
                                           Variant="Variant.Outlined"
                                           @bind-Value="Car.Item.HomeDetectionVia"
                                           Label='@T(TranslationKeys.CarSettingsHomeDetectionViaLabel)'
                                           Disabled="@IsBleDataCollectionActive"
                                           Margin="Constants.InputMargin">
                                    @foreach (var item in GetSelectableHomeDetectionViaValues())
                                    {
                                        <MudSelectItem T="HomeDetectionVia" Value="@item">@(GetHomeDetectionViaName(item))</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            @if (_getVehicleDataViaBle && Car.Item.UseBle)
                            {
                                @* With enabled Get data via BLE the car data is polled via BLE, so Fleet Telemetry is
                                   only needed (and automatically enabled) for tracking relevant fields. *@
                                <GenericInput T="bool"
                                              For="() => Car.Item.IncludeTrackingRelevantFields"
                                              OnValueChanged="newValue => { OnIncludeTrackingRelevantFieldsChangedForBleCar(newValue); Car.ClearErrors(nameof(Car.Item.UseFleetTelemetry), nameof(Car.Item.IncludeTrackingRelevantFields), nameof(Car.Item.HomeDetectionVia)); StateHasChanged(); }" />
                            }
                            else
                            {
                                <GenericInput T="bool"
                                              For="() => Car.Item.UseFleetTelemetry"
                                              OnValueChanged="newValue => { UpdateGetlocationDataViaFleetTelemetry(Car.Item, newValue); Car.ClearErrors(nameof(Car.Item.IncludeTrackingRelevantFields), nameof(Car.Item.HomeDetectionVia)); StateHasChanged(); }" />
                                @if (Car.Item.UseFleetTelemetry)
                                {
                                    <GenericInput T="bool"
                                                  For="() => Car.Item.IncludeTrackingRelevantFields"
                                                  OnValueChanged="_ => { Car.ClearErrors(nameof(Car.Item.HomeDetectionVia)); StateHasChanged(); }" />
                                }
                            }
                        </div>
                    }
                }

                @if (Car.Item.CarType != CarType.Tesla && Car.Item.ShouldBeManaged)
                {
                    <div class="mt-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@(Car.Item.CarType == CarType.SmartCar ? Icons.Material.Filled.LinkOff : Icons.Material.Filled.Link)"
                                   OnClick="ConnectToSmartCarClicked">
                            @(Car.Item.CarType == CarType.SmartCar ? T(TranslationKeys.CarSettingsSmartCarDisconnectTooltip) : T(TranslationKeys.CarSettingsSmartCarConnectTooltip))
                        </MudButton>
                    </div>
                }
            </EditFormComponent>
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (_showFleetApiTest)
        {
            @* The configuration is already saved at this point, so the test never blocks: the user can close the
               dialog at any time and the car stays managed. *@
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CloseAfterFleetApiTest">@T(TranslationKeys.GeneralClose)</MudButton>
        }
        else
        {
            <MudButton OnClick="Cancel">@T(TranslationKeys.GeneralCancel)</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_isSaving">@T(TranslationKeys.GeneralSave)</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public EditableItem<CarBasicConfiguration> Car { get; set; } = default!;

    /// <summary>
    /// Relative page (without leading slash) the SmartCar OAuth flow should return to, e.g. "CarSettings" or
    /// "setup". Keeps the user on the page the dialog was opened from instead of always landing on Car Settings.
    /// </summary>
    [Parameter] public string ReturnPage { get; set; } = "CarSettings";

    private EditFormComponent<CarBasicConfiguration>? _editForm;
    private bool _isSaving;
    private bool _getVehicleDataViaBle;
    private List<DtoBleAdapter> _bleAdapters = new();
    private bool _isLoadingBleAdapters;

    /// <summary>
    /// Whether the car was already managed when the dialog was opened. Only a car that is switched to be managed
    /// needs the Fleet API connection test, an already managed car has been through it before.
    /// </summary>
    private bool _wasManagedOnOpen;
    private TeslaCarFleetApiState? _fleetApiStateOnOpen;
    private bool _showFleetApiTest;

    private bool IsBleDataCollectionActive => _getVehicleDataViaBle && Car.Item.UseBle && !Car.Item.IncludeTrackingRelevantFields;

    private string T(string key) =>
        TextLocalizer.Get<CarSettingsPageLocalizationRegistry>(key, typeof(SharedComponentLocalizationRegistry))
        ?? key;

    private string Format(string key, params object?[] arguments) =>
        string.Format(CultureInfo.CurrentCulture, T(key), arguments);

    protected override async Task OnInitializedAsync()
    {
        _wasManagedOnOpen = Car.Item.ShouldBeManaged;
        if (Car.Item.CarType == CarType.Tesla && Car.Item.Id != default)
        {
            var fleetApiStateResult = await HomeService.GetFleetApiState(Car.Item.Id);
            _fleetApiStateOnOpen = fleetApiStateResult.Data;
        }
        var result = await HttpClientHelper.SendGetRequestAsync<DtoValue<bool>>("api/BaseConfiguration/GetVehicleDataViaBle");
        _getVehicleDataViaBle = !result.HasError && (result.Data?.Value == true);
        //Saving a car config while Get data via BLE is enabled switches the car to BLE data collection on the server,
        //so reflect that state in the UI right away.
        ApplyBleDataCollectionDefaultsIfNeeded();
        StateHasChanged();
        await LoadBleAdaptersAsync();
    }

    private async Task LoadBleAdaptersAsync()
    {
        if (!Car.Item.UseBle || string.IsNullOrWhiteSpace(Car.Item.BleApiBaseUrl))
        {
            _bleAdapters = new List<DtoBleAdapter>();
            StateHasChanged();
            return;
        }
        _isLoadingBleAdapters = true;
        StateHasChanged();
        var result = await HttpClientHelper.SendGetRequestAsync<List<DtoBleAdapter>>(
            $"api/Ble/GetAdapters?bleApiBaseUrl={Uri.EscapeDataString(Car.Item.BleApiBaseUrl)}");
        //An unreachable or outdated container just means no list to choose from; the stored selection is kept.
        _bleAdapters = result.HasError ? new List<DtoBleAdapter>() : (result.Data ?? new List<DtoBleAdapter>());
        _isLoadingBleAdapters = false;
        StateHasChanged();
    }

    private string GetAdapterDisplayName(DtoBleAdapter adapter)
    {
        var busName = adapter.Bus switch
        {
            "usb" => T(TranslationKeys.CarSettingsBleAdapterUsb),
            "uart" => T(TranslationKeys.CarSettingsBleAdapterOnboard),
            _ => adapter.Bus,
        };
        var product = string.IsNullOrWhiteSpace(adapter.UsbProduct) ? string.Empty : $" {adapter.UsbProduct}";
        return $"{busName}{product} ({adapter.Name}, {adapter.StableId}) - {adapter.State}";
    }

    private void ApplyBleDataCollectionDefaultsIfNeeded()
    {
        if (!IsBleDataCollectionActive || Car.Item.CarType != CarType.Tesla || !Car.Item.ShouldBeManaged)
        {
            return;
        }
        Car.Item.UseFleetTelemetry = false;
        Car.Item.HomeDetectionVia = HomeDetectionVia.BlePresence;
    }

    private void OnUseBleChanged(bool useBle)
    {
        if (!_getVehicleDataViaBle)
        {
            return;
        }
        if (useBle)
        {
            ApplyBleDataCollectionDefaultsIfNeeded();
        }
        else if (Car.Item.HomeDetectionVia == HomeDetectionVia.BlePresence)
        {
            //Without BLE the car needs Fleet Telemetry as data source again.
            Car.Item.UseFleetTelemetry = true;
            Car.Item.HomeDetectionVia = HomeDetectionVia.LocatedAtHome;
        }
    }

    private void OnIncludeTrackingRelevantFieldsChangedForBleCar(bool includeTrackingRelevantFields)
    {
        if (includeTrackingRelevantFields)
        {
            //Tracking relevant fields are only available via Fleet Telemetry, so the car keeps streaming its data.
            Car.Item.UseFleetTelemetry = true;
            if (Car.Item.HomeDetectionVia == HomeDetectionVia.BlePresence)
            {
                Car.Item.HomeDetectionVia = HomeDetectionVia.GpsLocation;
            }
        }
        else
        {
            ApplyBleDataCollectionDefaultsIfNeeded();
        }
    }

    private IEnumerable<HomeDetectionVia> GetSelectableHomeDetectionViaValues()
    {
        foreach (HomeDetectionVia item in Enum.GetValues(typeof(HomeDetectionVia)))
        {
            //BLE presence is only a valid option while the car data is collected via BLE.
            if (item == HomeDetectionVia.BlePresence && !IsBleDataCollectionActive)
            {
                continue;
            }
            yield return item;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void CloseAfterFleetApiTest() => MudDialog.Close(DialogResult.Ok(true));

    /// <summary>
    /// A Tesla that is switched to be managed needs a working Fleet API connection. Cars whose access is known to
    /// work are not tested again, so no unnecessary wake up is triggered.
    /// </summary>
    private bool ShouldTestFleetApiAccess => Car.Item.CarType == CarType.Tesla
                                             && Car.Item.Id != default
                                             && Car.Item.ShouldBeManaged
                                             && !_wasManagedOnOpen
                                             && _fleetApiStateOnOpen != TeslaCarFleetApiState.Ok;

    private async Task Submit()
    {
        // Run client-side (FluentValidation) validation before hitting the server so invalid values are shown
        // inline instead of coming back as a generic server error.
        if (!Car.EditContext.Validate())
        {
            return;
        }

        _isSaving = true;
        var result = await CarSettingsService.UpdateCarBasicConfiguration(Car.Item.Id, Car.Item);
        _isSaving = false;

        if (!result.HasError)
        {
            if (ShouldTestFleetApiAccess)
            {
                //A car that is not registered in the Tesla account can not be controlled by TSC. Instead of letting
                //the user find that out via the error box on the home page, run the test right away and guide them
                //through registering the virtual key. The car is saved already, so this never blocks anything.
                _showFleetApiTest = true;
                return;
            }
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }

        // Server-side validation errors (e.g. rules that only exist in the server validator) are shown
        // on the affected fields; anything else is a generic error the user can't fix inline.
        if (result.ValidationProblemDetails?.Errors.Any() == true)
        {
            Car.ApplyValidationErrors(result.ValidationProblemDetails.Errors);
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "EmptyErrorMessage", Severity.Error);
        }
    }

    private string GetHomeDetectionViaName(HomeDetectionVia homeDetectionVia)
    {
        return homeDetectionVia switch
        {
            HomeDetectionVia.GpsLocation => T(TranslationKeys.HomeDetectionViaGpsLocation),
            HomeDetectionVia.LocatedAtHome => T(TranslationKeys.HomeDetectionViaLocatedAtHome),
            HomeDetectionVia.LocatedAtWork => T(TranslationKeys.HomeDetectionViaLocatedAtWork),
            HomeDetectionVia.LocatedAtFavorite => T(TranslationKeys.HomeDetectionViaLocatedAtFavorite),
            HomeDetectionVia.BlePresence => T(TranslationKeys.HomeDetectionViaBlePresence),
            _ => homeDetectionVia.ToString(),
        };
    }

    private void UpdateGetlocationDataViaFleetTelemetry(CarBasicConfiguration carBasicConfiguration, bool newUseFleetTelemetryValue)
    {
        if (newUseFleetTelemetryValue) return;
        carBasicConfiguration.IncludeTrackingRelevantFields = newUseFleetTelemetryValue;
    }

    private async Task ConnectToSmartCarClicked()
    {
        if (string.IsNullOrEmpty(Car.Item.Vin))
        {
            Snackbar.Add(T(TranslationKeys.CarSettingsSmartCarVinMissingError), Severity.Error);
            return;
        }

        if (Car.Item.CarType == CarType.SmartCar)
        {
            var disconnectSuccess = await CarSettingsService.DisconnectCarFromSmartCar(Car.Item.Id);
            if (disconnectSuccess)
            {
                Car.Item.CarType = CarType.Manual;
                Snackbar.Add(T(TranslationKeys.CarSettingsSmartCarDisconnectSuccess), Severity.Success);
                StateHasChanged();
            }
            return;
        }

        // Connecting opens SmartCar's panel where the user may select several vehicles. Any selected
        // beyond their available car licenses are booked automatically and billed via Stripe, so get
        // explicit consent before redirecting.
        var confirmParameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, T(TranslationKeys.CarSettingsSmartCarBillingConfirmText) },
            { x => x.ConfirmButtonText, T(TranslationKeys.CarSettingsSmartCarBillingConfirmButton) },
            { x => x.CancelButtonText, T(TranslationKeys.GeneralCancel) },
        };
        var confirmDialog = await DialogService.ShowAsync<ConfirmDialog>(
            T(TranslationKeys.CarSettingsSmartCarBillingConfirmTitle), confirmParameters);
        var confirmResult = await confirmDialog.Result;
        if (confirmResult == null || confirmResult.Canceled)
        {
            return;
        }

        var baseUrl = NavigationManager.BaseUri + ReturnPage + "?" + Constants.QueryParamVin + "=" + Uri.EscapeDataString(Car.Item.Vin);
        var url = await CarSettingsService.GetSmartCarOAuthRedeemUrl(baseUrl, Car.Item.Vin);
        if (!string.IsNullOrEmpty(url))
        {
            NavigationManager.NavigateTo(url);
        }
    }
}
