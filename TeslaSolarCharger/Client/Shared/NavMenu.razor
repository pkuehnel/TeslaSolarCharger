@using TeslaSolarCharger.Shared.Localization
@using TeslaSolarCharger.Shared.Localization.Contracts
@using TeslaSolarCharger.Shared.Localization.Registries
@using TeslaSolarCharger.Shared.Localization.Registries.Components

@inject ITextLocalizationService TextLocalizer

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        @T(TranslationKeys.NavMenuOverview)
    </MudNavLink>
    <MudNavLink Href="ChargingStations" Icon="@Icons.Material.Outlined.EvStation">
        @T(TranslationKeys.ChargingStationsTitle)
    </MudNavLink>
    <MudNavLink Href="CarSettings" Icon="@Icons.Material.Filled.DirectionsCar">
        @T(TranslationKeys.CarsTitle)
    </MudNavLink>
    <MudNavLink Href="ChargePrices" Icon="@Icons.Material.Outlined.AttachMoney">
        @T(TranslationKeys.ChargeCostsListTitle)
    </MudNavLink>
    <MudNavLink Href="cloudconnection" Icon="@Icons.Material.Filled.Cloud">
        @T(TranslationKeys.CloudConnectionTitle)
    </MudNavLink>
    <MudNavLink Href="BaseConfiguration" Icon="@Icons.Material.Filled.Settings">
        @T(TranslationKeys.BaseConfigurationPageTitle)
    </MudNavLink>
    <MudNavLink Href="support" Icon="@Icons.Material.Filled.Help">
        @T(TranslationKeys.SupportPageTitle)
    </MudNavLink>
    <MudNavLink Href="backupAndRestore" Icon="@Icons.Material.Filled.Backup">
        @T(TranslationKeys.NavMenuBackupAndRestore)
    </MudNavLink>
</MudNavMenu>

@code {
    private string T(string key) =>
        TextLocalizer.Get<NavMenuComponentLocalizationRegistry>(key, typeof(SharedComponentLocalizationRegistry))
        ?? key;
}
