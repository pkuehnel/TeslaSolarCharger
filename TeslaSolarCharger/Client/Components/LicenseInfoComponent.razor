@using TeslaSolarCharger.Shared.Localization
@using TeslaSolarCharger.Shared.Localization.Contracts
@using TeslaSolarCharger.Shared.Localization.Registries.Pages

@inject ITextLocalizationService TextLocalizer

<MudAlert Severity="Severity.Info" Class="@Class">
    <MudText Typo="Typo.subtitle1" Style="font-weight: bold">@T(TranslationKeys.SetupLicenseInfoTitle)</MudText>
    <MudText Typo="Typo.body2">@T(TranslationKeys.SetupLicenseInfoContent)</MudText>
    <MudText Typo="Typo.body2" Class="mt-2"><b>@T(TranslationKeys.SetupLicenseInfoException)</b></MudText>
</MudAlert>

@code {
    [Parameter] public string? Class { get; set; }

    private string T(string key) =>
        TextLocalizer.Get<SetupPageLocalizationRegistry>(key)
        ?? key;
}
