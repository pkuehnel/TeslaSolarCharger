@using TeslaSolarCharger.Client.Helper.Contracts

@inject IJavaScriptWrapper JavaScriptWrapper

@* Info affordance next to an input, opening the matching README section in a new tab. Same button the charge mode
   on the home page uses, so the documentation stays the single place where the values are explained. *@

<div class="me-2 flex-grow-0">
    <MudIconButton Icon="@Icons.Material.Outlined.Info"
                   Color="Color.Primary"
                   OnClick="@(_ => JavaScriptWrapper.OpenUrlInNewTab(Url))" />
</div>

@code {
    [Parameter, EditorRequired]
    public string Url { get; set; } = string.Empty;
}
