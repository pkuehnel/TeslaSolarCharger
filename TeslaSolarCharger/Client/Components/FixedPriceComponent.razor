@using System.Globalization
@using TeslaSolarCharger.Shared.Dtos.ChargingCost.CostConfigurations
@using TeslaSolarCharger.Shared.Localization
@using TeslaSolarCharger.Shared.Localization.Contracts
@using TeslaSolarCharger.Shared.Localization.Registries
@using TeslaSolarCharger.Shared.Localization.Registries.Components
@inject ITextLocalizationService TextLocalizer

@if (FixedPrice == null)
{
    <LoadingSpinnerComponent />
}
else
{
    <div class="d-flex flex-wrap gap-2">
        @foreach (var day in Enum.GetValues<DayOfWeek>())
        {
            @* No list at all means the period applies every day, which is how the price is actually worked out.
               Showing that as "no days selected" told the user the opposite of what their tariff does. *@
            <MudCheckBox T="bool"
                         Value="@(FixedPrice.ValidOnDays == null || FixedPrice.ValidOnDays.Contains(day))"
                         ValueChanged="@(_ => CheckboxChanged(day))"
                         Label="@CultureInfo.CurrentCulture.DateTimeFormat.GetDayName(day)"
                         Dense="true" />
        }
    </div>
    <div class="d-flex align-center">
        <div class="flex-grow-1">
            <GenericInput For="() => FixedPrice.FromHour"
                          OnValueChanged="@((int _) => OnChanged.InvokeAsync())"
                          LabelName="@T(TranslationKeys.FixedPriceFromHour)"></GenericInput>
        </div>
        <div class="px-2">:</div>
        <div class="flex-grow-1">
            <GenericInput For="() => FixedPrice.FromMinute"
                          OnValueChanged="@((int _) => OnChanged.InvokeAsync())"
                          LabelName="@T(TranslationKeys.FixedPriceFromMinute)"></GenericInput>
        </div>
    </div>
    <div class="d-flex align-center">
        <div class="flex-grow-1">
            <GenericInput For="() => FixedPrice.ToHour"
                          OnValueChanged="@((int _) => OnChanged.InvokeAsync())"
                          LabelName="@T(TranslationKeys.FixedPriceToHour)"></GenericInput>
        </div>
        <div class="px-2">:</div>
        <div class="flex-grow-1">
            <GenericInput For="() => FixedPrice.ToMinute"
                          OnValueChanged="@((int _) => OnChanged.InvokeAsync())"
                          LabelName="@T(TranslationKeys.FixedPriceToMinute)"></GenericInput>
        </div>
    </div>

}

@code {
    [Parameter]
    public FixedPrice? FixedPrice { get; set; }

    /// <summary>
    /// Raised whenever a period changed, so a page that stores its answers as they are given can store this one
    /// too. Optional: where this sits inside a form that saves on its own there is nothing to do.
    /// </summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private string T(string key) =>
        TextLocalizer.Get<FixedPriceComponentLocalizationRegistry>(key, typeof(SharedComponentLocalizationRegistry))
        ?? key;

    private async Task CheckboxChanged(DayOfWeek day)
    {
        if (FixedPrice == null)
        {
            return;
        }

        //Written out as the days it actually covers before the first change. Bailing out here instead left every
        //checkbox on a newly added period doing nothing at all.
        FixedPrice.ValidOnDays ??= Enum.GetValues<DayOfWeek>().ToList();

        if (FixedPrice.ValidOnDays.Contains(day))
        {
            FixedPrice.ValidOnDays.Remove(day);
        }
        else
        {
            FixedPrice.ValidOnDays.Add(day);
        }

        await OnChanged.InvokeAsync();
    }
}
