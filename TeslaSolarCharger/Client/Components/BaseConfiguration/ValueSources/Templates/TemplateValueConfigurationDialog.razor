@using TeslaSolarCharger.Client.Components.BaseConfiguration.ValueSources.Templates.ConfigurationEditForms
@using TeslaSolarCharger.Client.Components.BaseConfiguration.ValueSources.Templates.ConfigurationEditForms.Contracts
@using TeslaSolarCharger.Client.Services.Contracts
@using TeslaSolarCharger.Client.Wrapper
@using TeslaSolarCharger.Shared.Dtos.TemplateConfiguration
@using TeslaSolarCharger.Shared.Dtos.TemplateConfiguration.Fronius
@using TeslaSolarCharger.Shared.Dtos.TemplateConfiguration.Generic
@using TeslaSolarCharger.Shared.Dtos.TemplateConfiguration.Kostal
@using TeslaSolarCharger.Shared.Dtos.TemplateConfiguration.Sma
@using TeslaSolarCharger.Shared.Dtos.TemplateConfiguration.Solax
@using TeslaSolarCharger.Shared.Dtos.TemplateConfiguration.TeslaPowerwall
@using TeslaSolarCharger.Shared.Enums
@using TeslaSolarCharger.Shared.Helper
@using TeslaSolarCharger.Shared.Helper.Contracts
@using TeslaSolarCharger.Shared.Resources.Contracts
@using TeslaSolarCharger.Shared.Localization
@using TeslaSolarCharger.Shared.Localization.Contracts
@using TeslaSolarCharger.Shared.Localization.Registries
@using TeslaSolarCharger.Shared.Localization.Registries.Components

@inject IConstants Constants
@inject IStringHelper StringHelper
@inject ITemplateValueConfigurationService Service
@inject ISnackbar Snackbar
@inject ITextLocalizationService TextLocalizer


@if (TemplateValueConfiguration == null)
{
    <LoadingSpinnerComponent />
}
else
{
    <MudDialog>
        <DialogContent>
            <EditFormComponent T="DtoTemplateValueConfigurationBase"
                               WrappedElement="TemplateValueConfiguration"
                               HideSubmitButton="true"
                               @ref="BaseForm">
                @if (ShowName)
                {
                    <GenericInput For="() => TemplateValueConfiguration.Item.Name"></GenericInput>
                }
                <div class="p-2">
                    @if (ShowTypeSelection)
                    {
                        @* The brand first, then only that brand's devices: one long list of every device of every brand
                           was hard to find anything in. *@
                        <MudSelect T="string"
                                   Variant="Variant.Outlined"
                                   Value="@_selectedVendor"
                                   Label="@T(TranslationKeys.ValueSourceConfigVendor)"
                                   Margin="Constants.InputMargin"
                                   ValueChanged="VendorChanged">
                            @foreach (var vendor in TemplateValueGatherTypeVendors.GetVendors())
                            {
                                <MudSelectItem T="string" Value="@vendor">@vendor</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="TemplateValueGatherType?"
                                   Variant="Variant.Outlined"
                                   Value="@TemplateValueConfiguration.Item.GatherType"
                                   Label="@T(TranslationKeys.ValueSourceConfigModel)"
                                   Margin="Constants.InputMargin"
                                   Disabled="@(_selectedVendor == null)"
                                   ToStringFunc="ModelName"
                                   ValueChanged="TypeChanged">
                            @foreach (var type in TemplateValueGatherTypeVendors.GetTypesOf(_selectedVendor))
                            {
                                <MudSelectItem T="TemplateValueGatherType?" Value="@((TemplateValueGatherType?)type)">@ModelName(type)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mb-2">@T(TranslationKeys.ValueSourceConfigConnectionIntro)</MudText>
                    }
                    @switch (TemplateValueConfiguration.Item.GatherType)
                    {
                        case TemplateValueGatherType.SmaEnergyMeter:
                            <SmaEnergyMeterEditForm Configuration="@(TemplateValueConfiguration.Item.Configuration?.ToObject<DtoSmaEnergyMeterTemplateValueConfiguration>())"
                                                    @ref="ConfigurationComponent" />
                            break;
                        case TemplateValueGatherType.SmaInverterModbus:
                            <SmaInverterEditForm Configuration="@(GetSmaConfig())"
                                                 @ref="ConfigurationComponent" />
                            break;
                        case TemplateValueGatherType.SmaHybridInverterModbus:
                            <SmaInverterEditForm Configuration="@(GetSmaConfig())"
                                                 ShowHomeBatteryControlFields="true"
                                                 @ref="ConfigurationComponent" />
                            break;
                        case TemplateValueGatherType.TeslaPowerwallFleetApi:
                            <TeslaPowerwallEditForm Configuration="@(TemplateValueConfiguration.Item.Configuration?.ToObject<DtoTeslaPowerwallTemplateValueConfiguration>())"
                                                    @ref="ConfigurationComponent" />
                            break;
                        case TemplateValueGatherType.SolaxApi:
                            <SolaxApiEditForm Configuration="@(TemplateValueConfiguration.Item.Configuration?.ToObject<DtoSolaxTemplateValueConfiguration>())"
                                              @ref="ConfigurationComponent" />
                            break;
                        case TemplateValueGatherType.KostalHybridInverterModbus:
                            <KostalInverterEditForm Configuration="@(TemplateValueConfiguration.Item.Configuration?.ToObject<DtoKostalModbusConfiguration>())"
                                              @ref="ConfigurationComponent" />
                            break;
                        case TemplateValueGatherType.FroniusSolarApiV1:
                            <FroniusSolarApiEditForm Configuration="@(TemplateValueConfiguration.Item.Configuration?.ToObject<DtoFroniusSolarApiTemplateValueConfiguration>())"
                                              @ref="ConfigurationComponent" />
                            break;
                        default:
                            if (TemplateValueConfiguration.Item.GatherType != default
                                && GenericModbusTemplateSettings.IsGenericModbusType(TemplateValueConfiguration.Item.GatherType.Value))
                            {
                                <GenericModbusInverterEditForm Configuration="@(TemplateValueConfiguration.Item.Configuration?.ToObject<DtoGenericModbusTemplateValueConfiguration>())"
                                                               GatherType="TemplateValueConfiguration.Item.GatherType.Value"
                                                               @ref="ConfigurationComponent" />
                            }
                            else if (TemplateValueConfiguration.Item.GatherType != default
                                     && GenericRestTemplateSettings.IsGenericRestType(TemplateValueConfiguration.Item.GatherType.Value))
                            {
                                <GenericRestEditForm Configuration="@(TemplateValueConfiguration.Item.Configuration?.ToObject<DtoGenericRestTemplateValueConfiguration>())"
                                                     GatherType="TemplateValueConfiguration.Item.GatherType.Value"
                                                     @ref="ConfigurationComponent" />
                            }
                            else if (TemplateValueConfiguration.Item.GatherType != default
                                     && SunSpecTemplateSettings.IsSunSpecType(TemplateValueConfiguration.Item.GatherType.Value))
                            {
                                <SunSpecEditForm Configuration="@(TemplateValueConfiguration.Item.Configuration?.ToObject<DtoSunSpecTemplateValueConfiguration>())"
                                                 GatherType="TemplateValueConfiguration.Item.GatherType.Value"
                                                 @ref="ConfigurationComponent" />
                            }
                            break;
                    }
                </div>
            </EditFormComponent>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">@T(TranslationKeys.ValueSourceConfigCancel)</MudButton>
            @* Nothing to connect until a device is chosen. *@
            <MudButton Color="Color.Primary" OnClick="Submit"
                       Disabled="@(TemplateValueConfiguration.Item.GatherType == null)">@T(TranslationKeys.ValueSourceConfigSave)</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int? ValueConfigurationId { get; set; }

    /// <summary>False where a label is not worth asking for: the dialog then names the device after its make and model.</summary>
    [Parameter]
    public bool ShowName { get; set; } = true;

    /// <summary>False where the device is already known and only how to reach it is left to change.</summary>
    [Parameter]
    public bool ShowTypeSelection { get; set; } = true;

    private EditableItem<DtoTemplateValueConfigurationBase>? TemplateValueConfiguration { get; set; }

    /// <summary>The brand whose devices the device list offers. Null until one is chosen.</summary>
    private string? _selectedVendor;

    /// <summary>The last name this dialog proposed, so a proposal can follow a changed type but a typed name is kept.</summary>
    private string? _suggestedName;
    private ITemplateEditFormComponent? ConfigurationComponent { get; set; }

    public EditFormComponent<DtoTemplateValueConfigurationBase>? BaseForm { get; set; }

    void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (TemplateValueConfiguration == default)
        {
            Snackbar.Add(T(TranslationKeys.ValueSourceConfigConfigNull), Severity.Error);
            return;
        }
        if (ConfigurationComponent == default)
        {
            Snackbar.Add(T(TranslationKeys.ValueSourceConfigFormNull), Severity.Error);
            return;
        }
        if (!ConfigurationComponent.Validate())
        {
            Snackbar.Add(T(TranslationKeys.ValueSourceConfigConfigurationValidationFailed), Severity.Error);
            return;
        }
        TemplateValueConfiguration.Item.Configuration = ConfigurationComponent.GetConfiguration();

        if (BaseForm == default)
        {
            Snackbar.Add(T(TranslationKeys.ValueSourceConfigFormNull), Severity.Error);
            return;
        }


        if (!BaseForm.WrappedElement.EditContext.Validate())
        {
            Snackbar.Add(T(TranslationKeys.ValueSourceConfigResultInvalid), Severity.Error);
            return;
        }
        var result = await Service.SaveAsync(TemplateValueConfiguration.Item);
        if (result.HasError)
        {
            return;
        }
        MudDialog.Close(DialogResult.Ok(result.Data));
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ValueConfigurationId != default)
        {
            var result = await Service.GetAsync(ValueConfigurationId.Value);
            if (!result.HasError && result.Data != default)
            {
                TemplateValueConfiguration = new(result.Data);
            }
        }
        TemplateValueConfiguration ??= new(new());
        var gatherType = TemplateValueConfiguration.Item.GatherType;
        _selectedVendor ??= gatherType == null ? null : TemplateValueGatherTypeVendors.GetVendor(gatherType.Value);
        await SuggestNameIfUnset();
    }

    /// <summary>
    /// Narrows the device list to the chosen brand. A device of another brand no longer fits and is dropped; a brand
    /// with a single device has nothing left to choose, so that device is taken straight away.
    /// </summary>
    private async Task VendorChanged(string? vendor)
    {
        if (TemplateValueConfiguration == default)
        {
            return;
        }

        _selectedVendor = vendor;
        var types = TemplateValueGatherTypeVendors.GetTypesOf(vendor);
        if (types.Count == 1)
        {
            await TypeChanged(types[0]);
            return;
        }

        var currentType = TemplateValueConfiguration.Item.GatherType;
        if (currentType != null && !types.Contains(currentType.Value))
        {
            TemplateValueConfiguration.Item.GatherType = null;
            //The form of the dropped device is gone from the page, so it must not be read on save either.
            ConfigurationComponent = null;
        }
    }

    private async Task TypeChanged(TemplateValueGatherType? newType)
    {
        if (newType == default || TemplateValueConfiguration == default)
        {
            return;
        }
        TemplateValueConfiguration.Item.GatherType = newType.Value;
        await SuggestNameIfUnset();
        StateHasChanged();
    }

    private string ModelName(TemplateValueGatherType? type) =>
        type == null ? string.Empty : TemplateValueGatherTypeVendors.GetModelName(type.Value, StringHelper);

    /// <summary>
    /// Names the device after its make and model. A name the user typed is theirs and is never replaced; only an
    /// empty one, or one this dialog proposed for a different type, is.
    /// </summary>
    private async Task SuggestNameIfUnset()
    {
        var item = TemplateValueConfiguration?.Item;
        if (item?.GatherType == default)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(item.Name) && item.Name != _suggestedName)
        {
            return;
        }

        var existingNames = (await Service.GetOverviews()).Select(o => o.Heading);
        _suggestedName = TemplateValueGatherTypeVendors.SuggestName(item.GatherType.Value, existingNames, StringHelper);
        item.Name = _suggestedName;
    }


    private DtoSmaInverterTemplateValueConfiguration? GetSmaConfig()
    {
        return TemplateValueConfiguration?.Item.Configuration?.ToObject<DtoSmaInverterTemplateValueConfiguration>();
    }

    private string T(string key) =>
        TextLocalizer.Get<ValueSourceConfigurationLocalizationRegistry>(key)
        ?? key;
}
