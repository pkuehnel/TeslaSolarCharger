@using TeslaSolarCharger.Shared.Dtos.IndexRazor.PvValues
@using TeslaSolarCharger.Shared.Resources.Contracts
@using TeslaSolarCharger.Client.Services.Contracts
@using TeslaSolarCharger.Shared.Localization
@using TeslaSolarCharger.Shared.Localization.Contracts
@using TeslaSolarCharger.Shared.Localization.Registries
@using TeslaSolarCharger.Shared.SignalRClients
@using TeslaSolarCharger.Shared.Dtos.BaseConfiguration
@using TeslaSolarCharger.Client.Helper.Contracts
@implements IDisposable

@inject IConstants Constants
@inject IAppColors AppColors
@inject ISignalRStateService SignalRStateService
@inject ITextLocalizationService TextLocalizer
@inject ILogger<PowerFlowComponent> Logger
@inject IThemeStateService ThemeStateService
@inject IHttpClientHelper HttpClientHelper

@if (_pvValues == default)
{
    <div class="pf-card">
        <PlaceholderComponent Height="@($"{ThirdLineY}px")"
                              Width="100%"
                              Class="d-flex justify-content-center"></PlaceholderComponent>
    </div>
}
else
{
    <div class="pf-card">
        <svg class="pf-svg" viewBox="@($"0 0 {_widthInPixel} {SvgHeight}")" preserveAspectRatio="xMidYMid meet">
            <defs>
                <!-- Soft glow used by active nodes -->
                <filter id="pf-node-glow" x="-60%" y="-60%" width="220%" height="220%">
                    <feGaussianBlur stdDeviation="5" />
                </filter>
                <!-- Directional gradient per active flow (bright at source, fades toward target) -->
                @for (var i = 0; i < Flows.Count; i++)
                {
                    var flow = Flows[i];
                    <linearGradient id="@($"pf-flow-grad-{i}")" gradientUnits="userSpaceOnUse"
                                    x1="@flow.StartX" y1="@flow.StartY" x2="@flow.EndX" y2="@flow.EndY">
                        <stop offset="0%" stop-color="@flow.Color" stop-opacity="0.95" />
                        <stop offset="100%" stop-color="@flow.Color" stop-opacity="0.25" />
                    </linearGradient>
                }
            </defs>

            <!-- Static connection lines (faint backdrop for every existing link) -->
            <!-- Grid to Solar -->
            @if (GridLocation != default && InverterLocation != default)
            {
                <line class="pf-link" x1="@GridLocation.X" y1="@GridLocation.Y" x2="@InverterLocation.X" y2="@InverterLocation.Y" />
            }
            <!-- Grid to House -->
            @if (GridLocation != default && HomeLocation != default)
            {
                <line class="pf-link" x1="@GridLocation.X" y1="@GridLocation.Y" x2="@HomeLocation.X" y2="@HomeLocation.Y" />
            }
            <!-- Solar to House -->
            @if (InverterLocation != default && HomeLocation != default)
            {
                <line class="pf-link" x1="@InverterLocation.X" y1="@InverterLocation.Y" x2="@HomeLocation.X" y2="@HomeLocation.Y" />
            }
            <!-- Solar to Home Battery -->
            @if (InverterLocation != default && BatteryLocation != default)
            {
                <line class="pf-link" x1="@InverterLocation.X" y1="@InverterLocation.Y" x2="@BatteryLocation.X" y2="@BatteryLocation.Y" />
            }
            <!-- Home Battery to House -->
            @if (HomeLocation != default && BatteryLocation != default)
            {
                <line class="pf-link" x1="@HomeLocation.X" y1="@HomeLocation.Y" x2="@BatteryLocation.X" y2="@BatteryLocation.Y" />
            }
            <!-- Grid to Home Battery -->
            @if (GridLocation != default && BatteryLocation != default)
            {
                <line class="pf-link" x1="@GridLocation.X" y1="@GridLocation.Y" x2="@BatteryLocation.X" y2="@BatteryLocation.Y" />
            }
            <!-- Home to Charger -->
            @if (HomeLocation != default && EvChargerLocation != default)
            {
                <line class="pf-link" x1="@HomeLocation.X" y1="@HomeLocation.Y" x2="@EvChargerLocation.X" y2="@EvChargerLocation.Y" />
            }

            @if (HomeLocation == default)
            {
                <!-- Grid to EvCharger -->
                @if (GridLocation != default && EvChargerLocation != default)
                {
                    <line class="pf-link" x1="@GridLocation.X" y1="@GridLocation.Y" x2="@EvChargerLocation.X" y2="@EvChargerLocation.Y" />
                }
                <!-- Solar to EVCharger -->
                @if (InverterLocation != default && EvChargerLocation != default)
                {
                    <line class="pf-link" x1="@InverterLocation.X" y1="@InverterLocation.Y" x2="@EvChargerLocation.X" y2="@EvChargerLocation.Y" />
                }
                <!-- Home Battery to EVCharger -->
                @if (EvChargerLocation != default && BatteryLocation != default)
                {
                    <line class="pf-link" x1="@EvChargerLocation.X" y1="@EvChargerLocation.Y" x2="@BatteryLocation.X" y2="@BatteryLocation.Y" />
                }
            }

            <!-- Animated gradient flow lines (direction = power flow direction) -->
            @for (var i = 0; i < Flows.Count; i++)
            {
                var flow = Flows[i];
                <line class="pf-flow" x1="@flow.StartX" y1="@flow.StartY" x2="@flow.EndX" y2="@flow.EndY"
                      stroke="@($"url(#pf-flow-grad-{i})")" />
            }

            <!-- Nodes -->
            @if (GridLocation != default)
            {
                @NodeShape(GridLocation, GridNodeColor, _pvValues.GridPower != 0)
            }
            @if (InverterLocation != default)
            {
                @NodeShape(InverterLocation, AppColors.SolarPowerColor, _pvValues.InverterPower > 0)
            }
            @if (BatteryLocation != default)
            {
                @NodeShape(BatteryLocation, BatteryNodeColor, _pvValues.HomeBatteryPower != 0)
            }
            @if (HomeLocation != default)
            {
                @NodeShape(HomeLocation, AppColors.HomeConsumptionColor, CalculateHomePower() > 0)
            }
            @if (EvChargerLocation != default)
            {
                @NodeShape(EvChargerLocation, AppColors.EvChargingColor, _pvValues.CarCombinedChargingPowerAtHome > 0)
            }

            <!-- Node content (icon + value + label) -->
            @if (GridLocation != default)
            {
                <foreignObject x="@(GridLocation.X - NodeRadius)" y="@(GridLocation.Y - NodeRadius)" width="@(NodeRadius * 2)" height="@(NodeRadius * 2)">
                    <div class="pf-node-content">
                        <MudIcon Icon="@Constants.GridPoleIcon" Size="Size.Medium" />
                        <span class="pf-node-value">@(Math.Abs(_pvValues.GridPower ?? 0).ToString("N0")) @T(TranslationKeys.UnitWatts)</span>
                        <span class="pf-node-label">@T(TranslationKeys.PowerFlowNodeGrid)</span>
                    </div>
                </foreignObject>
            }
            @if (InverterLocation != default)
            {
                <foreignObject x="@(InverterLocation.X - NodeRadius)" y="@(InverterLocation.Y - NodeRadius)" width="@(NodeRadius * 2)" height="@(NodeRadius * 2)">
                    <div class="pf-node-content">
                        <MudIcon Icon="@Constants.SolarPowerIcon" Size="Size.Medium" />
                        <span class="pf-node-value">@(_pvValues.InverterPower?.ToString("N0")) @T(TranslationKeys.UnitWatts)</span>
                        <span class="pf-node-label">@T(TranslationKeys.PowerFlowNodeSolar)</span>
                    </div>
                </foreignObject>
            }
            @if (BatteryLocation != default)
            {
                <foreignObject x="@(BatteryLocation.X - NodeRadius)" y="@(BatteryLocation.Y - NodeRadius)" width="@(NodeRadius * 2)" height="@(NodeRadius * 2)">
                    <div class="pf-node-content">
                        <BatteryIcon StateOfCharge="@_pvValues.HomeBatterySoc" Color="@BatteryColor" />
                        <span class="pf-node-value">@(Math.Abs(_pvValues.HomeBatteryPower ?? 0).ToString("N0")) @T(TranslationKeys.UnitWatts)</span>
                        <span class="pf-node-label">@T(TranslationKeys.PowerFlowNodeBattery)</span>
                    </div>
                </foreignObject>
            }
            @if (HomeLocation != default)
            {
                <foreignObject x="@(HomeLocation.X - NodeRadius)" y="@(HomeLocation.Y - NodeRadius)" width="@(NodeRadius * 2)" height="@(NodeRadius * 2)">
                    <div class="pf-node-content">
                        <MudIcon Icon="@Constants.HomePowerIcon" Size="Size.Medium" />
                        <span class="pf-node-value">@CalculateHomePower()?.ToString("N0") @T(TranslationKeys.UnitWatts)</span>
                        <span class="pf-node-label">@T(TranslationKeys.PowerFlowNodeHome)</span>
                    </div>
                </foreignObject>
            }
            @if (EvChargerLocation != default)
            {
                <foreignObject x="@(EvChargerLocation.X - NodeRadius)" y="@(EvChargerLocation.Y - NodeRadius)" width="@(NodeRadius * 2)" height="@(NodeRadius * 2)">
                    <div class="pf-node-content">
                        <MudIcon Icon="@Icons.Material.Outlined.EvStation" Size="Size.Medium" />
                        <span class="pf-node-value">@_pvValues.CarCombinedChargingPowerAtHome?.ToString("N0") @T(TranslationKeys.UnitWatts)</span>
                        <span class="pf-node-label">@T(TranslationKeys.PowerFlowNodeCar)</span>
                    </div>
                </foreignObject>
            }
        </svg>
    </div>
}


@code {
    private List<Flow> Flows { get; set; } = new();

    private DtoPvValues? _pvValues;
    private DtoDynamicMinSocSettings? _dynamicMinSocSettings;

    // viewBox width; the rendered width is responsive (see PowerFlowComponent.razor.css).
    private readonly int _widthInPixel = 720;

    private const int BatterySocWarningThreshold = 15;

    private const int NodeRadius = 42;
    private const int NodeRingWidth = 4;

    private IDisposable? _subscription;
    private IDisposable? _dynamicMinSocSubscription;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        ThemeStateService.OnDarkModeChanged += OnDarkModeChangedHandler;

        await RefreshDynamicMinSocSettings();

        _dynamicMinSocSubscription = await SignalRStateService.SubscribeToTrigger(
            DataTypeConstants.DynamicHomeBatteryMinSocChangeTrigger,
            async void () =>
            {
                try
                {
                    await RefreshDynamicMinSocSettings();
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception e)
                {
                    Logger.LogError(e, "{method}() failed", nameof(RefreshDynamicMinSocSettings));
                }
            });

        // Subscribe to PV value changes
        _subscription = await SignalRStateService.Subscribe<DtoPvValues>(
            DataTypeConstants.PvValues, async void (pvValues) =>
            {
                try
                {
                    _pvValues = pvValues;
                    await UpdateFlows();
                }
                catch (Exception e)
                {
                    Logger.LogError(e, "Could not update PV value changes");
                }
            });

        // Get initial state
        _pvValues = await SignalRStateService.GetStateAsync<DtoPvValues>(DataTypeConstants.PvValues);
        await UpdateFlows();
    }

    private async Task OnDarkModeChangedHandler(bool isDarkMode)
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
        });
    }

    // Renders the visual node: optional glow (when active), themed background, brand tint and colored ring.
    private RenderFragment NodeShape(Location loc, string color, bool active) => @<g class="@(active ? "pf-node pf-node--active" : "pf-node pf-node--idle")">
        @if (active)
        {
            <circle cx="@loc.X" cy="@loc.Y" r="@NodeRadius" fill="@color" class="pf-node-glow" filter="url(#pf-node-glow)" />
        }
        <circle cx="@loc.X" cy="@loc.Y" r="@NodeRadius" class="pf-node-bg" />
        <circle cx="@loc.X" cy="@loc.Y" r="@NodeRadius" fill="@color" class="pf-node-tint" />
        <circle cx="@loc.X" cy="@loc.Y" r="@NodeRadius" fill="none" stroke="@color" stroke-width="@NodeRingWidth" class="pf-node-ring" />
    </g>;

    private async Task UpdateFlows()
    {
        if (_pvValues == default)
        {
            return;
        }
        Flows.Clear();

        if (_pvValues.InverterPower > 0)
        {
            if (InverterLocation != default)
            {
                if (GridLocation != default && _pvValues.GridPower > 0)
                {
                    Flows.Add(new Flow(AppColors.SolarPowerColor)
                    {
                        StartX = InverterLocation.X,
                        StartY = InverterLocation.Y,
                        EndX = GridLocation.X,
                        EndY = GridLocation.Y,
                    });
                }
                if (HomeLocation != default)
                {
                    Flows.Add(new Flow(AppColors.SolarPowerColor)
                    {
                        StartX = InverterLocation.X,
                        StartY = InverterLocation.Y,
                        EndX = HomeLocation.X,
                        EndY = HomeLocation.Y,
                    });
                }
                if (BatteryLocation != default && _pvValues.HomeBatteryPower > 0)
                {
                    Flows.Add(new Flow(AppColors.SolarPowerColor)
                    {
                        StartX = InverterLocation.X,
                        StartY = InverterLocation.Y,
                        EndX = BatteryLocation.X,
                        EndY = BatteryLocation.Y,
                    });
                }
            }
        }

        // Grid power flow
        if (_pvValues.GridPower < 0)
        {
            if (GridLocation != default)
            {
                if (HomeLocation != default && CalculateHomePower() + _pvValues.CarCombinedChargingPowerAtHome > 0)
                {
                    Flows.Add(new Flow(AppColors.GridColor)
                    {
                        StartX = GridLocation.X,
                        StartY = GridLocation.Y,
                        EndX = HomeLocation.X,
                        EndY = HomeLocation.Y,
                    });
                }

                if (BatteryLocation != default && _pvValues.HomeBatteryPower > 0)
                {
                    Flows.Add(new Flow(AppColors.GridColor)
                    {
                        StartX = GridLocation.X,
                        StartY = GridLocation.Y,
                        EndX = BatteryLocation.X,
                        EndY = BatteryLocation.Y,
                    });
                }
            }
        }

        // Home Battery power flow
        if (_pvValues.HomeBatteryPower < 0)  // Battery discharging
        {
            if (BatteryLocation != default)
            {
                if (HomeLocation != default && CalculateHomePower() + _pvValues.CarCombinedChargingPowerAtHome > 0)
                {
                    Flows.Add(new Flow(AppColors.BatteryColor)
                    {
                        StartX = BatteryLocation.X,
                        StartY = BatteryLocation.Y,
                        EndX = HomeLocation.X,
                        EndY = HomeLocation.Y,
                    });
                }
                if (GridLocation != default && _pvValues.GridPower > 0)
                {
                    Flows.Add(new Flow(AppColors.BatteryColor)
                    {
                        StartX = BatteryLocation.X,
                        StartY = BatteryLocation.Y,
                        EndX = GridLocation.X,
                        EndY = GridLocation.Y,
                    });
                }
            }
        }

        //EvCharger flow
        if (_pvValues.CarCombinedChargingPowerAtHome > 0 && EvChargerLocation != default)
        {
            var homeLocation = HomeLocation;
            if (homeLocation != default)
            {
                Flows.Add(new Flow(AppColors.HomeConsumptionColor)
                {
                    StartX = homeLocation.X,
                    StartY = homeLocation.Y,
                    EndX = EvChargerLocation.X,
                    EndY = EvChargerLocation.Y,
                });
            }
            else
            {
                if (InverterLocation != default && _pvValues.InverterPower > 0)
                {
                    Flows.Add(new Flow(AppColors.SolarPowerColor)
                    {
                        StartX = InverterLocation.X,
                        StartY = InverterLocation.Y,
                        EndX = EvChargerLocation.X,
                        EndY = EvChargerLocation.Y,
                    });
                }

                if (GridLocation != default && _pvValues.GridPower < 0)
                {
                    Flows.Add(new Flow(AppColors.GridColor)
                    {
                        StartX = GridLocation.X,
                        StartY = GridLocation.Y,
                        EndX = EvChargerLocation.X,
                        EndY = EvChargerLocation.Y,
                    });
                }

                if (BatteryLocation != default && _pvValues.HomeBatteryPower < 0)
                {
                    Flows.Add(new Flow(AppColors.BatteryColor)
                    {
                        StartX = BatteryLocation.X,
                        StartY = BatteryLocation.Y,
                        EndX = EvChargerLocation.X,
                        EndY = EvChargerLocation.Y,
                    });
                }
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private int SvgHeight
    {
        get
        {
            var size = 0;
            if (InverterLocation?.Y > size)
            {
                size = InverterLocation.Y;
            }
            if (GridLocation?.Y > size)
            {
                size = GridLocation.Y;
            }
            if (BatteryLocation?.Y > size)
            {
                size = BatteryLocation.Y;
            }
            if (HomeLocation?.Y > size)
            {
                size = HomeLocation.Y;
            }
            if (EvChargerLocation?.Y > size)
            {
                size = EvChargerLocation.Y;
            }

            return size > 0 ? size + NodeRadius + 6 : 0;
        }
    }

    private Location? InverterLocation
    {
        get
        {
            if (_pvValues?.InverterPower != default)
            {
                return new Location()
                {
                    X = SecondColumnX,
                    Y = FirstLineY,
                };
            }
            return null;
        }
    }

    private Location? GridLocation
    {
        get
        {
            if (_pvValues?.GridPower == default)
            {
                return null;
            }

            var y = SecondLineY;
            if (_pvValues?.InverterPower == default)
            {
                y = FirstLineY;
            }

            return new Location()
            {
                X = FirstColumnX,
                Y = y,
            };
        }
    }

    private Location? BatteryLocation
    {
        get
        {
            if (_pvValues?.HomeBatteryPower == default)
            {
                return null;
            }
            var y = SecondLineY;
            if (_pvValues?.InverterPower == default)
            {
                y = FirstLineY;
            }
            return new Location()
            {
                X = ThirdColumnX,
                Y = y,
            };
        }
    }

    private Location? HomeLocation
    {
        get
        {
            var homePower = CalculateHomePower();
            if (homePower == default || _pvValues == default)
            {
                return null;
            }
            var location = GetFreePlaceAfterSolarGridAndBattery();
            if (location?.Y == ThirdLineY)
            {
                location.X = (SecondColumnX - FirstColumnX) / 2 + FirstColumnX;
            }

            return location;
        }
    }

    private Location? EvChargerLocation
    {
        get
        {
            if (_pvValues == default)
            {
                return null;
            }
            var homeLocation = HomeLocation;
            if (homeLocation == default)
            {
                return GetFreePlaceAfterSolarGridAndBattery();
            }

            if (homeLocation.Y == SecondLineY)
            {
                if (homeLocation.X == SecondColumnX)
                {
                    return new Location()
                    {
                        X = ThirdColumnX,
                        Y = SecondLineY,
                    };
                }
                else
                {
                    return new Location()
                    {
                        X = SecondColumnX,
                        Y = ThirdLineY,
                    };
                }

            }

            return new Location()
            {
                X = (ThirdColumnX - SecondColumnX) / 2 + SecondColumnX,
                Y = ThirdLineY,
            };
        }
    }

    private Location? GetFreePlaceAfterSolarGridAndBattery()
    {
        var lineNumber = 1;
        if (_pvValues == default)
        {
            return null;
        }
        if (_pvValues.InverterPower != default)
        {
            lineNumber++;
        }
        if (_pvValues.GridPower != default && _pvValues.HomeBatteryPower != default)
        {
            lineNumber++;
        }

        var yCoordinate = lineNumber switch
        {
            1 => FirstLineY,
            2 => SecondLineY,
            3 => ThirdLineY,
            _ => throw new ArgumentOutOfRangeException(nameof(lineNumber), lineNumber, "Value must be 1, 2 or 3."),
        };
        var xCoordinate = SecondColumnX;
        if (_pvValues.GridPower == default)
        {
            xCoordinate = ThirdColumnX;
        }
        return new Location()
        {
            X = xCoordinate,
            Y = yCoordinate,
        };
    }

    private const int FirstLineY = 50;
    private const int SecondLineY = 145;
    private const int ThirdLineY = 240;

    private const int FirstColumnX = 115;
    private const int SecondColumnX = 360;
    private const int ThirdColumnX = 605;

    public class Location
    {
        public int X { get; set; }
        public int Y { get; set; }
    }

    public class Flow
    {
        public Flow(string color)
        {
            Color = color;
        }

        public int StartX { get; set; }
        public int StartY { get; set; }
        public int EndX { get; set; }
        public int EndY { get; set; }
        public string Color { get; set; }
    }

    private int? CalculateHomePower()
    {
        if (_pvValues == null)
        {
            return null;
        }

        if (_pvValues.InverterPower == null)
        {
            return null;
        }

        if (_pvValues.GridPower == null)
        {
            return null;
        }
        var homeBatteryPower = _pvValues.HomeBatteryPower ?? 0;
        var chargingPower = _pvValues.CarCombinedChargingPowerAtHome ?? 0;
        var homePower = _pvValues.InverterPower - _pvValues.GridPower - homeBatteryPower - chargingPower;
        return homePower;
    }


    // Grid node colour reflects flow direction: green when feeding into the grid,
    // red when consuming from the grid, identity colour when idle.
    private string GridNodeColor
    {
        get
        {
            var power = _pvValues?.GridPower ?? 0;
            if (power > 0) return AppColors.FeedInColor;
            if (power < 0) return AppColors.ConsumptionColor;
            return AppColors.GridColor;
        }
    }

    // Home battery node colour reflects flow direction: green when charging,
    // red when discharging, identity colour when idle.
    private string BatteryNodeColor
    {
        get
        {
            var power = _pvValues?.HomeBatteryPower ?? 0;
            if (power > 0) return AppColors.FeedInColor;
            if (power < 0) return AppColors.ConsumptionColor;
            return AppColors.BatteryColor;
        }
    }

    private string? BatteryColor
    {
        get
        {
            if (_pvValues?.HomeBatterySoc == null) return null;
            if (_dynamicMinSocSettings?.DynamicHomeBatteryMinSoc != true) return null;

            var soc = _pvValues.HomeBatterySoc.Value;
            var minSoc = _dynamicMinSocSettings.HomeBatteryMinSoc ?? 0;
            var minDynamicMinSoc = _dynamicMinSocSettings.HomeBatteryMinDynamicMinSoc ?? 5;
            var maxDynamicMinSoc = _dynamicMinSocSettings.HomeBatteryMaxDynamicMinSoc ?? 95;

            if (minSoc == minDynamicMinSoc || soc >= maxDynamicMinSoc) return AppColors.BatterySocGoodColor;

            if (soc < minSoc - BatterySocWarningThreshold) return AppColors.BatterySocCriticalColor;
            if (soc > minSoc + BatterySocWarningThreshold) return AppColors.BatterySocGoodColor;

            return AppColors.BatterySocWarningColor;
        }
    }

    private async Task RefreshDynamicMinSocSettings()
    {
        _dynamicMinSocSettings = await HttpClientHelper.SendGetRequestWithSnackbarAsync<DtoDynamicMinSocSettings>("/api/BaseConfiguration/GetDynamicMinSocSettings");
    }

    private string T(string key) =>
        TextLocalizer.Get<SharedComponentLocalizationRegistry>(key, typeof(SharedComponentLocalizationRegistry))
        ?? key;

    public void Dispose()
    {
        _subscription?.Dispose();
        _dynamicMinSocSubscription?.Dispose();
        ThemeStateService.OnDarkModeChanged -= OnDarkModeChangedHandler;
    }
}
