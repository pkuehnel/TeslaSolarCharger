@using System.Globalization
@using TeslaSolarCharger.Client.Services.Contracts
@using TeslaSolarCharger.Shared.Contracts
@using TeslaSolarCharger.Shared.Dtos.BaseConfiguration
@using TeslaSolarCharger.Shared.Dtos.IndexRazor.PvValues
@using TeslaSolarCharger.Shared.Localization
@using TeslaSolarCharger.Shared.Localization.Contracts
@using TeslaSolarCharger.Shared.Localization.Registries
@using TeslaSolarCharger.Shared.Localization.Registries.Pages
@using TeslaSolarCharger.Shared.SignalRClients
@using TeslaSolarCharger.SharedModel.Enums

@implements IDisposable

@inject ITextLocalizationService TextLocalizer
@inject IDateTimeProvider DateTimeProvider
@inject ISignalRStateService SignalRStateService
@inject ILogger<SetupMeasurementStatus> Logger

@* What we can actually read, in the units the user recognises and with the time it last arrived. A number with no
   timestamp cannot be told apart from a number that stopped updating three days ago. *@
<div class="p-3 rounded border @Class">
    <MudText Typo="Typo.subtitle2" GutterBottom="true">@T(TranslationKeys.SetupMeasurementsTitle)</MudText>

    @foreach (var usage in ExpectedUsages)
    {
        var total = _pvValues?.ValueFor(usage);
        <div class="d-flex align-center flex-wrap py-1" style="gap: 8px;">
            <MudIcon Icon="@(total != null ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.HourglassEmpty)"
                     Color="@(total != null ? Color.Success : Color.Warning)" Size="Size.Small" />
            <MudText Typo="Typo.body2" Style="font-weight: bold; min-width: 190px;">@T(NameKeyOf(usage))</MudText>
            @if (total != null)
            {
                <MudText Typo="Typo.body2">@DescribeValue(usage, total.Value)</MudText>
                <MudText Typo="Typo.caption">@DescribeAge(OldestReadingOf(usage))</MudText>
            }
            else if (IsConfigured(usage))
            {
                <MudText Typo="Typo.body2">@T(TranslationKeys.SetupMeasurementWaitingForData)</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2">@T(TranslationKeys.SetupMeasurementNotConfigured)</MudText>
            }
        </div>
    }

    @if (ExpectedUsages.Any(u => _pvValues?.ValueFor(u) == null && !IsConfigured(u)))
    {
        <MudText Typo="Typo.caption" Class="d-block mt-2">@T(TranslationKeys.SetupMeasurementMissingHint)</MudText>
    }
</div>

@code {
    /// <summary>
    /// Every configured source, as the value configuration screens report them. Only used to tell a device that has
    /// not delivered anything yet apart from no device at all; the readings themselves arrive live.
    /// </summary>
    [Parameter, EditorRequired] public List<DtoValueConfigurationOverview> Configurations { get; set; } = new();

    /// <summary>Which measurements this installation should have, given what the user said they own.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ValueUsage> ExpectedUsages { get; set; } = Array.Empty<ValueUsage>();

    [Parameter] public string? Class { get; set; }

    /// <summary>The same values the charging logic uses, pushed whenever the devices are read.</summary>
    private DtoPvValues? _pvValues;

    private IDisposable? _subscription;

    protected override async Task OnInitializedAsync()
    {
        _subscription = await SignalRStateService.Subscribe<DtoPvValues>(DataTypeConstants.PvValues, async void (pvValues) =>
        {
            try
            {
                _pvValues = pvValues;
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Could not show the updated readings");
            }
        });
        _pvValues = await SignalRStateService.GetStateAsync<DtoPvValues>(DataTypeConstants.PvValues);
    }

    private bool IsConfigured(ValueUsage usage) => Configurations
        .SelectMany(c => c.Results)
        .Any(r => r.UsedFor == usage);

    /// <summary>
    /// When the least recently read device supplying <paramref name="usage"/> last delivered. A total is only as fresh
    /// as the oldest value in it, so one device that stopped answering must not hide behind another one that did not.
    /// </summary>
    private DateTimeOffset OldestReadingOf(ValueUsage usage) => _pvValues!.SourceValues
        .Where(v => v.UsedFor == usage)
        .Min(v => v.LastUpdated);

    /// <summary>
    /// Says what the number means rather than only showing it, because the sign carries the direction and a bare
    /// "-1200 W" does not tell anyone whether that is electricity bought or sold.
    /// </summary>
    private string DescribeValue(ValueUsage usage, int value)
    {
        var magnitude = Math.Abs(value).ToString("N0", CultureInfo.CurrentCulture);
        return usage switch
        {
            ValueUsage.GridPower => value switch
            {
                > 0 => Format(TranslationKeys.SetupMeasurementGridExportFormat, magnitude),
                < 0 => Format(TranslationKeys.SetupMeasurementGridImportFormat, magnitude),
                _ => T(TranslationKeys.SetupMeasurementGridBalanced),
            },
            ValueUsage.HomeBatteryPower => value switch
            {
                > 0 => Format(TranslationKeys.SetupMeasurementBatteryChargingFormat, magnitude),
                < 0 => Format(TranslationKeys.SetupMeasurementBatteryDischargingFormat, magnitude),
                _ => T(TranslationKeys.SetupMeasurementBatteryIdle),
            },
            ValueUsage.HomeBatterySoc => Format(TranslationKeys.SetupMeasurementBatterySocFormat, magnitude),
            _ => Format(TranslationKeys.SetupMeasurementSolarFormat, magnitude),
        };
    }

    private string DescribeAge(DateTimeOffset lastRefreshed)
    {
        var age = DateTimeProvider.DateTimeOffSetUtcNow() - lastRefreshed;
        if (age < TimeSpan.FromMinutes(2))
        {
            return T(TranslationKeys.SetupMeasurementJustNow);
        }

        return age < TimeSpan.FromHours(1)
            ? Format(TranslationKeys.SetupMeasurementMinutesAgoFormat, (int)age.TotalMinutes)
            : Format(TranslationKeys.SetupMeasurementHoursAgoFormat, (int)age.TotalHours);
    }

    private static string NameKeyOf(ValueUsage usage) => usage switch
    {
        ValueUsage.GridPower => TranslationKeys.SetupMeasurementGridName,
        ValueUsage.InverterPower => TranslationKeys.SetupMeasurementSolarName,
        ValueUsage.HomeBatterySoc => TranslationKeys.SetupMeasurementBatterySocName,
        _ => TranslationKeys.SetupMeasurementBatteryPowerName,
    };

    private string T(string key) =>
        TextLocalizer.Get<SetupPageLocalizationRegistry>(key, typeof(SharedComponentLocalizationRegistry))
        ?? key;

    private string Format(string key, params object?[] arguments) =>
        string.Format(CultureInfo.CurrentCulture, T(key), arguments);

    public void Dispose()
    {
        _subscription?.Dispose();
    }
}
