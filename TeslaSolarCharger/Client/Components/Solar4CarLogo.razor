@*
    Solar4Car wordmark (inline SVG).
    The letters use currentColor so they follow the surrounding text colour
    (dark ink in light mode, light in dark mode); the sun (the "o") and the "4"
    stay brand amber. Used in the app bar and anywhere the wordmark is needed.
*@
<svg class="s4c-logo" viewBox="0 0 162 40" role="img" aria-label="Solar4Car"
     style="@($"height:{Height}px;width:auto;display:block;overflow:visible")"
     xmlns="http://www.w3.org/2000/svg">
    <g font-family="'Poppins','Segoe UI',Roboto,Helvetica,Arial,sans-serif" font-weight="600">
        <text x="4" y="29" font-size="30" fill="currentColor">S</text>
        <g stroke="#F5A623" stroke-width="2.2" stroke-linecap="round">
            <line x1="23" y1="21" x2="49" y2="21" />
            <line x1="36" y1="8" x2="36" y2="34" />
            <line x1="26.8" y1="11.8" x2="45.2" y2="30.2" />
            <line x1="26.8" y1="30.2" x2="45.2" y2="11.8" />
        </g>
        <circle cx="36" cy="21" r="8" fill="#F5A623" />
        <text x="50" y="29" font-size="30" fill="currentColor">lar</text>
        <text x="88" y="29" font-size="30" fill="#F5A623">4</text>
        <text x="106" y="29" font-size="30" fill="currentColor">Car</text>
    </g>
</svg>

@code {
    [Parameter] public int Height { get; set; } = 32;
}
