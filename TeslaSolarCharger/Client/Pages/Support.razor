@page "/support"
@using System.Globalization
@using PkSoftwareService.Custom.Backend
@using TeslaSolarCharger.Client.Components.StartPage
@using TeslaSolarCharger.Client.Helper.Contracts
@using TeslaSolarCharger.Shared.Dtos
@using TeslaSolarCharger.Shared.Dtos.Ble
@using TeslaSolarCharger.Shared.Dtos.HomeBatteryControl
@using TeslaSolarCharger.Shared.Dtos.Support
@using TeslaSolarCharger.Shared.Localization
@using TeslaSolarCharger.Shared.Localization.Contracts
@using TeslaSolarCharger.Shared.Localization.Registries
@using TeslaSolarCharger.Shared.Localization.Registries.Pages
@using TeslaSolarCharger.SharedModel.Enums

@inject IHttpClientHelper HttpClientHelper
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject IInMemorySink InMemorySink
@inject IJavaScriptWrapper JavaScriptWrapper
@inject ITextLocalizationService TextLocalizer

<h1>@T(TranslationKeys.SupportPageTitle)</h1>

<h3>@T(TranslationKeys.SupportLoggingSectionTitle)</h3>

<MudAlert Severity="Severity.Warning"
          NoIcon="true"
          ContentAlignment="HorizontalAlignment.Left">
    <h5>@T(TranslationKeys.SupportNeverShareLogsPubliclyTitle)</h5>
    @T(TranslationKeys.SupportNeverShareLogsPubliclyContent)
</MudAlert>

<RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportDownloadServerLogsButton)'
                             StartIcon="@Icons.Material.Filled.Download"
                             OnButtonClicked="@(_ => NavigationManager.NavigateTo("api/Debug/DownloadInMemoryLogs", true))"></RightAlignedButtonComponent>

<MudAlert Severity="Severity.Warning"
          NoIcon="true"
          ContentAlignment="HorizontalAlignment.Left">
    @T(TranslationKeys.SupportConfigurationWarning)
</MudAlert>

<div class="row">
    @if (_inMemoryLogCapacity == default || _inMemoryLogLevel == default)
    {
        <PlaceholderComponent></PlaceholderComponent>
    }
    else
    {
        <div class="col">
            <GenericInput For="() => _inMemoryLogLevel.Value"
                          LabelName='@T(TranslationKeys.SupportInMemoryLogLevelLabel)'
                          ShouldBeInErrorState="@(_inMemoryLogLevelSetErrorMessage != default)"
                          ErrorMessage="@_inMemoryLogLevelSetErrorMessage"
                          OnButtonClicked="@(UpdateInMemoryLogLevel)"
                          StringIdDropDownOptions="LogLevelOptions"
                          PostfixButtonStartIcon="@Icons.Material.Filled.Save" />
        </div>
        <div class="col">
            <GenericInput For="() => _inMemoryLogCapacity.Value"
                          LabelName='@T(TranslationKeys.SupportInMemoryLogCapacityLabel)'
                          ShouldBeInErrorState="@(_inMemoryLogCapacitySetErrorMessage != default)"
                          ErrorMessage="@_inMemoryLogCapacitySetErrorMessage"
                          OnButtonClicked="@(UpdateInMemoryLogCapacity)"
                          PostfixButtonStartIcon="@Icons.Material.Filled.Save" />
        </div>
    }
</div>
<div class="row">
    @if (_fileLogLevel == default)
    {
        <PlaceholderComponent></PlaceholderComponent>
    }
    else
    {
        <div class="col">
            <GenericInput For="() => _fileLogLevel.Value"
                          LabelName='@T(TranslationKeys.SupportFileLogLevelLabel)'
                          ShouldBeInErrorState="@(_fileLogLevelSetErrorMessage != default)"
                          ErrorMessage="@_fileLogLevelSetErrorMessage"
                          OnButtonClicked="@(UpdateFileLogLevel)"
                          StringIdDropDownOptions="LogLevelOptions"
                          PostfixButtonStartIcon="@Icons.Material.Filled.Save" />
        </div>
        <div class="col">
            <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportDownloadServerFileLogsButton)'
                                         StartIcon="@Icons.Material.Filled.Download"
                                         OnButtonClicked="@(_ => NavigationManager.NavigateTo("api/Debug/DownloadFileLogs", true))"></RightAlignedButtonComponent>
        </div>
    }
</div>

@if (_bleContainers is { Count: > 0 })
{
    <h4>@T(TranslationKeys.SupportBleContainerLogsSectionTitle)</h4>
    @foreach (var bleContainer in _bleContainers)
    {
        <div class="mb-2">
            <div>@Format(TranslationKeys.SupportBleContainerUsedByFormat, string.Join(", ", bleContainer.CarNames))</div>
            <RightAlignedButtonComponent ButtonText="@Format(TranslationKeys.SupportDownloadBleContainerLogsButtonFormat, bleContainer.BleApiBaseUrl)"
                                         StartIcon="@Icons.Material.Filled.Download"
                                         OnButtonClicked="@(_ => NavigationManager.NavigateTo($"api/Ble/DownloadLogs?bleApiBaseUrl={Uri.EscapeDataString(bleContainer.BleApiBaseUrl)}", true))"></RightAlignedButtonComponent>
        </div>
    }
}

<hr />

<MudExpansionPanels>
    <MudExpansionPanel Text='@T(TranslationKeys.SupportUiLogsSectionTitle)' ExpandedChanged="UiLogExpansionChanged">
        <div>@Format(TranslationKeys.SupportFetchedLogsFormat, _uiLogMessages.Count)</div>
        <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportCopyLogsToClipboardButton)'
                                     StartIcon="@Icons.Material.Filled.ContentCopy"
                                     OnButtonClicked="CopyLogsToClipboard"></RightAlignedButtonComponent>
        @foreach (var logMessage in _uiLogMessages)
        {
            <div>@logMessage</div>
        }
    </MudExpansionPanel>
</MudExpansionPanels>

<h3>@T(TranslationKeys.SupportCarDebugDetailsSectionTitle)</h3>
@if (_debugCars == default)
{
    <PlaceholderComponent Count="3"></PlaceholderComponent>
}
else
{
    <MudExpansionPanels MultiExpansion="true">
        @foreach (var car in _debugCars)
        {
            <MudExpansionPanel Text="@car.Value.Name">
                <div>@Format(TranslationKeys.SupportIdFormat, car.Key)</div>
                <div>@Format(TranslationKeys.SupportVinFormat, car.Value.Vin)</div>
                <div>@Format(TranslationKeys.SupportNameFormat, car.Value.Name)</div>
                <div>@Format(TranslationKeys.SupportIsAvailableInTeslaAccountFormat, car.Value.IsAvailableInTeslaAccount)</div>
                <div>@Format(TranslationKeys.SupportShouldBeManagedFormat, car.Value.ShouldBeManaged)</div>

                @if (car.Value.Vin != default && _fleetTelemetryGetConfigs.TryGetValue(car.Key, out var config))
                {
                    <h4>@T(TranslationKeys.SupportResultTitle)</h4>
                    <pre>@config</pre>
                }

                <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportGetFleetTelemetryConfigButton)'
                                             IsLoading="@_isFleetTelemetryLoading"
                                             IsDisabled="@(car.Value.Vin == default || !car.Value.IsAvailableInTeslaAccount)"
                                             DisabledToolTipText="@(car.Value.IsAvailableInTeslaAccount ? null : T(TranslationKeys.SupportCarNotPartOfTeslaAccountTooltip))"
                                             OnButtonClicked="@(() => GetFleetTelemetryConfig(car.Key))"></RightAlignedButtonComponent>
                <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportGetCarStateButton)'
                                             IsLoading="@_isFleetTelemetryLoading"
                                             IsDisabled="@(car.Value.Vin == default)"
                                             DisabledToolTipText="@(car.Value.IsAvailableInTeslaAccount ? null : T(TranslationKeys.SupportVinUnknownTooltip))"
                                             OnButtonClicked="@(() => GetDtoCar(car.Key))"></RightAlignedButtonComponent>

                @if (car.Value.Vin != default && _fleetTelemetrySetResults.TryGetValue(car.Key, out var result))
                {
                    <h4>@T(TranslationKeys.SupportFleetTelemetrySetResultTitle)</h4>
                    <pre>@result</pre>
                }

                <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportNormalFleetConfigurationSetButton)'
                                             IsLoading="@_isFleetTelemetryLoading"
                                             IsDisabled="@(car.Value.Vin == default || !car.Value.IsAvailableInTeslaAccount)"
                                             DisabledToolTipText="@(car.Value.IsAvailableInTeslaAccount ? null : T(TranslationKeys.SupportCarNotPartOfTeslaAccountSetTooltip))"
                                             OnButtonClicked="@(() => SetFleetTelemetryConfig(car.Key, false))"></RightAlignedButtonComponent>
                <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportForceFleetConfigurationSetButton)'
                                             IsLoading="@_isFleetTelemetryLoading"
                                             IsDisabled="@(car.Value.Vin == default || !car.Value.IsAvailableInTeslaAccount)"
                                             DisabledToolTipText="@(car.Value.IsAvailableInTeslaAccount ? null : T(TranslationKeys.SupportCarNotPartOfTeslaAccountSetTooltip))"
                                             OnButtonClicked="@(() => SetFleetTelemetryConfig(car.Key, true))"></RightAlignedButtonComponent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

<h3>@T(TranslationKeys.SupportHomeBatterySectionTitle)</h3>
@if (_homeBatteryControlState == default)
{
    <PlaceholderComponent></PlaceholderComponent>
}
else if (_homeBatteryControlState.Controllers.Count == 0)
{
    <MudAlert Severity="Severity.Info"
              NoIcon="true"
              ContentAlignment="HorizontalAlignment.Left">
        @T(TranslationKeys.SupportHomeBatteryNoControllersMessage)
    </MudAlert>
}
else
{
    <MudAlert Severity="Severity.Info"
              NoIcon="true"
              ContentAlignment="HorizontalAlignment.Left">
        @T(TranslationKeys.SupportHomeBatteryValidationHint)
    </MudAlert>
    @if (_homeBatteryControlState.ManualOverrideMode == HomeBatteryMode.Charge
         && _homeBatteryControlState.HomeBatterySoc >= _homeBatteryControlState.MaxChargeSoc)
    {
        <MudAlert Severity="Severity.Warning"
                  NoIcon="true"
                  ContentAlignment="HorizontalAlignment.Left">
            @Format(TranslationKeys.SupportHomeBatteryChargeDemotedWarningFormat, _homeBatteryControlState.HomeBatterySoc, _homeBatteryControlState.MaxChargeSoc)
        </MudAlert>
    }
    <div class="mt-2">@Format(TranslationKeys.SupportHomeBatteryCurrentModeFormat, GetHomeBatteryModeDisplayName(_homeBatteryControlState.CurrentMode))</div>
    @if (_homeBatteryControlState.ManualOverrideMode != default)
    {
        <div>@Format(TranslationKeys.SupportHomeBatteryOverrideFormat, GetHomeBatteryModeDisplayName(_homeBatteryControlState.ManualOverrideMode.Value), _homeBatteryControlState.ManualOverrideValidUntil?.LocalDateTime.ToLongTimeString())</div>
    }
    else
    {
        <div>@T(TranslationKeys.SupportHomeBatteryNoOverrideMessage)</div>
    }
    <div>@Format(TranslationKeys.SupportHomeBatterySocFormat, _homeBatteryControlState.HomeBatterySoc?.ToString() ?? T(TranslationKeys.SupportNoData))</div>
    <div>@Format(TranslationKeys.SupportHomeBatteryPowerFormat, _homeBatteryControlState.HomeBatteryPower?.ToString() ?? T(TranslationKeys.SupportNoData))</div>
    <div>@Format(TranslationKeys.SupportHomeBatteryMaxChargeSocFormat, _homeBatteryControlState.MaxChargeSoc)</div>
    @if (_homeBatteryControlState.AutomaticControlEnabled)
    {
        <div class="mt-2">@T(TranslationKeys.SupportHomeBatteryAutomaticControlEnabledMessage)</div>
        <h5 class="mt-2">@T(TranslationKeys.SupportHomeBatteryPlannedWindowsTitle)</h5>
        @if (_homeBatteryControlState.PlannedWindows.Count == 0)
        {
            <div>@T(TranslationKeys.SupportHomeBatteryNoPlannedWindowsMessage)</div>
        }
        else
        {
            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <th>@T(TranslationKeys.SupportHomeBatteryWindowFromHeader)</th>
                        <th>@T(TranslationKeys.SupportHomeBatteryWindowToHeader)</th>
                        <th>@T(TranslationKeys.SupportHomeBatteryWindowModeHeader)</th>
                        <th>@T(TranslationKeys.SupportHomeBatteryWindowReasonHeader)</th>
                        <th>@T(TranslationKeys.SupportHomeBatteryWindowEnergyHeader)</th>
                        <th>@T(TranslationKeys.SupportHomeBatteryWindowPriceHeader)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plannedWindow in _homeBatteryControlState.PlannedWindows)
                    {
                        <tr>
                            <td>@plannedWindow.ValidFrom.LocalDateTime.ToString("g")</td>
                            <td>@plannedWindow.ValidTo.LocalDateTime.ToString("g")</td>
                            <td>@GetHomeBatteryModeDisplayName(plannedWindow.Mode)</td>
                            <td>@GetHomeBatteryWindowReasonDisplayName(plannedWindow.Reason)</td>
                            <td>@(plannedWindow.PlannedEnergyWh > 0 ? $"{plannedWindow.PlannedEnergyWh} Wh" : "-")</td>
                            <td>@plannedWindow.GridPricePerKwh.ToString("0.00##")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
    @foreach (var homeBatteryController in _homeBatteryControlState.Controllers)
    {
        <div class="mt-2">
            <div><b>@homeBatteryController.Name</b>@(homeBatteryController.RequiresPeriodicRewrite ? $" ({T(TranslationKeys.SupportHomeBatteryPeriodicRewriteText)})" : string.Empty)</div>
            <div>@Format(TranslationKeys.SupportHomeBatteryLastWriteFormat, homeBatteryController.LastSuccessfulWrite?.LocalDateTime.ToString() ?? T(TranslationKeys.SupportNoData))</div>
            @if (!string.IsNullOrEmpty(homeBatteryController.LastError))
            {
                <MudAlert Severity="Severity.Error"
                          NoIcon="true"
                          ContentAlignment="HorizontalAlignment.Left">
                    @Format(TranslationKeys.SupportHomeBatteryLastErrorFormat, homeBatteryController.LastError)
                </MudAlert>
            }
        </div>
    }
    <div class="row">
        <div class="col">
            <GenericInput For="() => _homeBatteryModeToSet.Value"
                          LabelName='@T(TranslationKeys.SupportHomeBatteryModeToSetLabel)'
                          StringIdDropDownOptions="HomeBatteryModeOptions" />
        </div>
        <div class="col">
            <GenericInput For="() => _homeBatteryOverrideDurationMinutes.Value"
                          LabelName='@T(TranslationKeys.SupportHomeBatteryDurationLabel)' />
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportHomeBatterySetModeButton)'
                                     IsLoading="@_homeBatteryCommandLoading"
                                     OnButtonClicked="SetHomeBatteryMode"></RightAlignedButtonComponent>
        <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportHomeBatteryClearOverrideButton)'
                                     IsLoading="@_homeBatteryCommandLoading"
                                     OnButtonClicked="ClearHomeBatteryOverride"></RightAlignedButtonComponent>
        <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportHomeBatteryRefreshButton)'
                                     IsLoading="@_homeBatteryCommandLoading"
                                     OnButtonClicked="RefreshHomeBatteryControlState"></RightAlignedButtonComponent>
    </div>
}

<h3>@T(TranslationKeys.SupportChargingStationDebugDetailsSectionTitle)</h3>
@if (_debugChargingConnectors == default)
{
    <PlaceholderComponent Count="3"></PlaceholderComponent>
}
else
{
    <MudExpansionPanels MultiExpansion="true">
        @foreach (var connector in _debugChargingConnectors)
        {
            <MudExpansionPanel Text='@Format(TranslationKeys.SupportConnectorFormat, connector.Value.ChargePointId, connector.Value.ConnectorId, connector.Value.Name)'>
                <div>@Format(TranslationKeys.SupportIdFormat, connector.Key)</div>
                <div class="row">
                    <div class="col">
                        <GenericInput For="() => _chargingCurrentsToSet[connector.Key].Value"
                                      LabelName='@T(TranslationKeys.SupportChargingCurrentToSetLabel)'
                                      HelperText='@T(TranslationKeys.SupportChargingCurrentToSetHelperText)'></GenericInput>
                    </div>
                    <div class="col">
                        <GenericInput For="() => _chargingPhasesToSet[connector.Key].Value"
                                      LabelName='@T(TranslationKeys.SupportChargingPhasesToSetLabel)'
                                      HelperText='@T(TranslationKeys.SupportChargingPhasesToSetHelperText)'></GenericInput>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportStartChargingButton)'
                                                 IsLoading="@_loadingOcppCommands.Contains(connector.Key)"
                                                 OnButtonClicked="@(() => StartCharging(connector.Value.ChargePointId, connector.Value.ConnectorId, connector.Key))"></RightAlignedButtonComponent>
                    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportStopChargingButton)'
                                                 IsLoading="@_loadingOcppCommands.Contains(connector.Key)"
                                                 OnButtonClicked="@(() => StopCharging(connector.Value.ChargePointId, connector.Value.ConnectorId, connector.Key))"></RightAlignedButtonComponent>
                    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportSetCurrentAndPhasesButton)'
                                                 IsLoading="@_loadingOcppCommands.Contains(connector.Key)"
                                                 OnButtonClicked="@(() => SetCurrentAndPhases(connector.Value.ChargePointId, connector.Value.ConnectorId, connector.Key))"></RightAlignedButtonComponent>
                </div>
                <hr />
                <div class="row">
                    <div class="col">
                        <GenericInput For="() => _configurationKeysToGet[connector.Key].Value"
                                      LabelName='@T(TranslationKeys.SupportConfigurationKeyToGetLabel)'></GenericInput>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportGetConnectorStateButton)'
                                                 IsLoading="@_loadingOcppCommands.Contains(connector.Key)"
                                                 OnButtonClicked="@(() => GetConnectorState(connector.Key))"></RightAlignedButtonComponent>
                    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportGetConfigurationKeyButton)'
                                                 IsLoading="@_loadingOcppCommands.Contains(connector.Key)"
                                                 OnButtonClicked="@(() => GetConfigurationKey(connector.Value.ChargePointId, connector.Key))"></RightAlignedButtonComponent>
                    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportSetMeterDataConfigurationButton)'
                                                 IsLoading="@_loadingOcppCommands.Contains(connector.Key)"
                                                 OnButtonClicked="@(() => SetMeterDataConfiguration(connector.Value.ChargePointId, connector.Key))"></RightAlignedButtonComponent>
                    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportSetMeterIntervalConfigurationButton)'
                                                 IsLoading="@_loadingOcppCommands.Contains(connector.Key)"
                                                 OnButtonClicked="@(() => SetMeterIntervalConfiguration(connector.Value.ChargePointId, connector.Key))"></RightAlignedButtonComponent>
                    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportRebootChargerButton)'
                                                 IsLoading="@_loadingOcppCommands.Contains(connector.Key)"
                                                 OnButtonClicked="@(() => RebootCharger(connector.Value.ChargePointId, connector.Key))"></RightAlignedButtonComponent>
                    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportTriggerStatusNotificationButton)'
                                                 IsLoading="@_loadingOcppCommands.Contains(connector.Key)"
                                                 OnButtonClicked="@(() => TriggerStatusNotification(connector.Value.ChargePointId, connector.Key))"></RightAlignedButtonComponent>
                </div>

                @if (_commandResults.TryGetValue(connector.Key, out var result))
                {
                    <h4>@T(TranslationKeys.SupportCommandResultTitle)</h4>
                    <pre>@result</pre>
                }
            </MudExpansionPanel>
        }
    </MudExpansionPanels>

    <h3>@T(TranslationKeys.SupportMeterValuesSectionTitle)</h3>

    @if (_loadingMeterValues)
    {
        <MudPaper Class="d-flex justify-end flex-grow-1 gap-4 pr-2 mb-2" Elevation="0">
            <MudAlert Severity="Severity.Info">
                @T(TranslationKeys.SupportMeterValuesLoadingMessage)
            </MudAlert>
        </MudPaper>
    }

    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportGetLatestMeterValuesButton)'
                                 IsLoading="@_loadingMeterValues"
                                 OnButtonClicked="GetMeterValues"></RightAlignedButtonComponent>
    @if (_meterValueDetails != default)
    {
        <pre>@_meterValueDetails</pre>
    }

    <h3>@T(TranslationKeys.SupportChargingPricesSectionTitle)</h3>
    <GenericInput For="() => ChargingPricesFrom" LabelName="@T(TranslationKeys.SupportChargingPricesFrom)"></GenericInput>
    <GenericInput For="() => ChargingPricesTo" LabelName="@T(TranslationKeys.SupportChargingPricesTo)"></GenericInput>
    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportGetPriceValuesButton)'
                                 IsLoading="@_loadingGridPrices"
                                 OnButtonClicked="GetGridValues"></RightAlignedButtonComponent>
    @if (_gridPricesDetails != default)
    {
        <pre>@_gridPricesDetails</pre>
    }

    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportClearTeslaTokenEncryptionKeyButton)'
                                 IsLoading="@_loadingClearEncryptionKeys"
                                 OnButtonClicked="ClearTeslaTokenEncryptionKeys"></RightAlignedButtonComponent>

    @if (!string.IsNullOrEmpty(_clearEncryptionKeysResult))
    {
        <pre>@_clearEncryptionKeysResult</pre>
    }

    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.SupportReloadPageButton)'
                                 OnButtonClicked="JavaScriptWrapper.ReloadPage"></RightAlignedButtonComponent>

    <HiddenErrorsComponent></HiddenErrorsComponent>
    <InstallationInformation></InstallationInformation>
}

@code {
    private readonly Dictionary<int, string> _fleetTelemetryGetConfigs = new();

    private readonly Dictionary<int, string> _fleetTelemetrySetResults = new();

    private Dictionary<int, DtoDebugCar>? _debugCars;
    private bool _isFleetTelemetryLoading;

    private Dictionary<int, DtoDebugChargingConnector>? _debugChargingConnectors;
    private readonly HashSet<int> _loadingOcppCommands = new();
    private readonly Dictionary<int, DtoValue<decimal>> _chargingCurrentsToSet = new();
    private readonly Dictionary<int, DtoValue<int?>> _chargingPhasesToSet = new();
    private readonly Dictionary<int, DtoValue<string>> _configurationKeysToGet = new();
    private readonly Dictionary<int, string> _commandResults = new();
    private List<string> _uiLogMessages = new();

    private DtoValue<string>? _inMemoryLogLevel;
    private string? _inMemoryLogLevelSetErrorMessage;
    private DtoValue<int>? _inMemoryLogCapacity;
    private string? _inMemoryLogCapacitySetErrorMessage;
    private DtoValue<string>? _fileLogLevel;
    private string? _fileLogLevelSetErrorMessage;

    private List<DtoBleContainer>? _bleContainers;

    private bool _loadingMeterValues;
    private string? _meterValueDetails;

    private bool _loadingGridPrices;
    private string? _gridPricesDetails;

    private bool _loadingClearEncryptionKeys;
    private string? _clearEncryptionKeysResult;

    private DtoHomeBatteryControlState? _homeBatteryControlState;
    private readonly DtoValue<string> _homeBatteryModeToSet = new(nameof(HomeBatteryMode.Hold));
    private readonly DtoValue<int> _homeBatteryOverrideDurationMinutes = new(10);
    private bool _homeBatteryCommandLoading;

    public DateTime? ChargingPricesFrom { get; set; }
    public DateTime? ChargingPricesTo { get; set; }

    private Dictionary<string, string> HomeBatteryModeOptions => new()
    {
        { nameof(HomeBatteryMode.Normal), T(TranslationKeys.HomeBatteryModeNormal) },
        { nameof(HomeBatteryMode.Hold), T(TranslationKeys.HomeBatteryModeHold) },
        { nameof(HomeBatteryMode.Charge), T(TranslationKeys.HomeBatteryModeCharge) },
    };

    private Dictionary<string, string> LogLevelOptions => new()
    {
        { "Verbose", T(TranslationKeys.LogLevelVerbose) },
        { "Debug", T(TranslationKeys.LogLevelDebug) },
        { "Information", T(TranslationKeys.LogLevelInformation) },
        { "Warning", T(TranslationKeys.LogLevelWarning) },
        { "Error", T(TranslationKeys.LogLevelError) },
        { "Fatal", T(TranslationKeys.LogLevelFatal) },
    };

    protected override async Task OnInitializedAsync()
    {
        var cars = await HttpClientHelper.SendGetRequestWithSnackbarAsync<Dictionary<int, DtoDebugCar>>("api/Debug/GetCars");
        if (cars != default)
        {
            _debugCars = cars;
        }
        await RefreshChargingConnectors();
        _inMemoryLogLevel = await HttpClientHelper.SendGetRequestWithSnackbarAsync<DtoValue<string>>("api/Debug/GetInMemoryLogLevel");
        _fileLogLevel = await HttpClientHelper.SendGetRequestWithSnackbarAsync<DtoValue<string>>("api/Debug/GetFileLogLevel");
        _inMemoryLogCapacity = await HttpClientHelper.SendGetRequestWithSnackbarAsync<DtoValue<int>>("api/Debug/GetInMemoryLogCapacity");
        _bleContainers = await HttpClientHelper.SendGetRequestWithSnackbarAsync<List<DtoBleContainer>>("api/Ble/GetBleContainers");
        await RefreshHomeBatteryControlState();
    }

    private async Task RefreshHomeBatteryControlState()
    {
        var state = await HttpClientHelper.SendGetRequestWithSnackbarAsync<DtoHomeBatteryControlState>("api/Debug/GetHomeBatteryControlState");
        if (state != default)
        {
            _homeBatteryControlState = state;
        }
    }

    private string GetHomeBatteryModeDisplayName(HomeBatteryMode mode) => mode switch
    {
        HomeBatteryMode.Normal => T(TranslationKeys.HomeBatteryModeNormal),
        HomeBatteryMode.Hold => T(TranslationKeys.HomeBatteryModeHold),
        HomeBatteryMode.Charge => T(TranslationKeys.HomeBatteryModeCharge),
        _ => T(TranslationKeys.HomeBatteryModeUnknown),
    };

    private string GetHomeBatteryWindowReasonDisplayName(HomeBatteryScheduleWindowReason reason) => reason switch
    {
        HomeBatteryScheduleWindowReason.CarGridCharging => T(TranslationKeys.HomeBatteryWindowReasonCarGridCharging),
        HomeBatteryScheduleWindowReason.PreserveForDeficit => T(TranslationKeys.HomeBatteryWindowReasonPreserveForDeficit),
        HomeBatteryScheduleWindowReason.GridChargeForDeficit => T(TranslationKeys.HomeBatteryWindowReasonGridChargeForDeficit),
        _ => reason.ToString(),
    };

    private async Task SetHomeBatteryMode()
    {
        if (string.IsNullOrEmpty(_homeBatteryModeToSet.Value))
        {
            return;
        }
        _homeBatteryCommandLoading = true;
        var result = await HttpClientHelper.SendPostRequestAsync<DtoHomeBatteryControlState>(
            $"api/Debug/SetHomeBatteryMode?mode={Uri.EscapeDataString(_homeBatteryModeToSet.Value)}&durationMinutes={_homeBatteryOverrideDurationMinutes.Value}", null);
        _homeBatteryCommandLoading = false;
        if (result.HasError)
        {
            Snackbar.Add(result.ErrorMessage ?? T(TranslationKeys.SupportNoError), Severity.Error);
            return;
        }
        _homeBatteryControlState = result.Data;
        Snackbar.Add(T(TranslationKeys.SupportHomeBatteryModeSetNotification), Severity.Success);
    }

    private async Task ClearHomeBatteryOverride()
    {
        _homeBatteryCommandLoading = true;
        var result = await HttpClientHelper.SendPostRequestAsync<DtoHomeBatteryControlState>("api/Debug/ClearHomeBatteryMode", null);
        _homeBatteryCommandLoading = false;
        if (result.HasError)
        {
            Snackbar.Add(result.ErrorMessage ?? T(TranslationKeys.SupportNoError), Severity.Error);
            return;
        }
        _homeBatteryControlState = result.Data;
        Snackbar.Add(T(TranslationKeys.SupportHomeBatteryOverrideClearedNotification), Severity.Success);
    }

    private async Task RefreshChargingConnectors()
    {
        var connectors = await HttpClientHelper.SendGetRequestWithSnackbarAsync<Dictionary<int, DtoDebugChargingConnector>>("api/Debug/GetChargingConnectors");
        if (connectors != default)
        {
            _chargingCurrentsToSet.Clear();
            _chargingPhasesToSet.Clear();
            _configurationKeysToGet.Clear();
            var defaultChargingCurrent = 6;
            foreach (var connector in connectors)
            {
                _chargingCurrentsToSet.Add(connector.Key, new(defaultChargingCurrent));
                _chargingPhasesToSet.Add(connector.Key, new(null));
                _configurationKeysToGet.Add(connector.Key, new(string.Empty));
            }
            _debugChargingConnectors = connectors;
        }
    }

