    private async Task GetGridValues()
    {
        if (ChargingPricesFrom == default || ChargingPricesTo == default)
        {
            return;
        }

        _loadingGridPrices = true;
        var from = new DateTimeOffset(ChargingPricesFrom.Value, TimeSpan.Zero);
        var to = new DateTimeOffset(ChargingPricesTo.Value, TimeSpan.Zero);
        var result = await HttpClientHelper.SendGetRequestAsync<DtoValue<string>>($"api/Debug/GetGridPrices?from={Uri.EscapeDataString(from.ToString("o"))}&to={Uri.EscapeDataString(to.AddDays(1).ToString("o"))}");
        if (result.HasError)
        {
            _gridPricesDetails = result.ErrorMessage ?? T(TranslationKeys.SupportNoError);
        }
        else
        {
            _gridPricesDetails = result.Data?.Value ?? T(TranslationKeys.SupportNoData);
        }
        _loadingGridPrices = false;
    }

