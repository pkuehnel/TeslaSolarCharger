@page "/setup"
@implements IDisposable
@using TeslaSolarCharger.Client.Components.BaseConfiguration.ValueSources.Templates
@using TeslaSolarCharger.Client.Components.BaseConfiguration.ValueSources.Rest
@using TeslaSolarCharger.Client.Components.BaseConfiguration.ValueSources.Modbus
@using TeslaSolarCharger.Client.Components.BaseConfiguration.ValueSources.Mqtt
@using TeslaSolarCharger.Client.Helper.Contracts
@using TeslaSolarCharger.Client.Services.Contracts
@using TeslaSolarCharger.Client.Wrapper
@using TeslaSolarCharger.Shared.Contracts
@using TeslaSolarCharger.Shared.Dtos.BaseConfiguration
@using TeslaSolarCharger.Shared.Dtos.Setup
@using TeslaSolarCharger.Shared.Localization
@using TeslaSolarCharger.Shared.Localization.Contracts
@using TeslaSolarCharger.Shared.Localization.Registries
@using TeslaSolarCharger.Shared.Localization.Registries.Pages
@using TeslaSolarCharger.Shared.Dtos.ChargingCost
@using TeslaSolarCharger.Shared.Dtos.ChargingStation
@using TeslaSolarCharger.Shared.Enums
@using Newtonsoft.Json
@using TeslaSolarCharger.Shared.Dtos.ChargingCost.CostConfigurations
@using TeslaSolarCharger.Client.Dialogs

@inject IHttpClientHelper HttpClientHelper
@inject ISetupService SetupService
@inject ITextLocalizationService TextLocalizer
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ITemplateValueConfigurationService TemplateService
@inject IChargePriceService ChargePriceService
@inject IChargingStationsService ChargingStationsService
@inject ICloudConnectionCheckService CloudConnectionCheckService
@inject IDateTimeProvider DateTimeProvider
@inject IDialogService DialogService

<PageTitle>@T(TranslationKeys.SetupAssistantTitle)</PageTitle>

<ChargingStationDeletionOverlay @ref="_stationDeletionOverlay" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true">@T(TranslationKeys.SetupAssistantTitle)</MudText>

    @if (_dtoBaseConfiguration == null)
    {
        <LoadingSpinnerComponent />
    }
    else
    {
        <MudStepper @ref="_stepper"
                    NonLinear="true"
                    CenterLabels="true"
                    ActiveIndex="_activeStepIndex"
                    ActiveIndexChanged="OnStepChanged"
                    OnPreviewInteraction="OnStepPreviewInteraction"
                    CurrentStepColor="Color.Primary"
                    CompletedStepColor="Color.Success">
            <ChildContent>
                <MudStep Title="@T(TranslationKeys.SetupStepWelcome)">
                    <MudText>@T(TranslationKeys.SetupWelcomeDescription)</MudText>
                    <MudAlert Severity="Severity.Info" Class="mt-4">
                        @T(TranslationKeys.SetupChangeLaterInfo)
                    </MudAlert>
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepCloudConnection)">
                    <MudText GutterBottom="true">@T(TranslationKeys.SetupCloudConnectionDescription)</MudText>

                    <div class="mt-4">
                        <CloudConnectionLoginComponent OnConnectionStateChanged="OnCloudConnectionStateChanged" />
                    </div>

                    @if (_cloudConnected && !_baseAppLicensed)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-4">
                            <div>@T(TranslationKeys.SetupBaseAppLicenseMissingInfo)</div>
                            <MudLink Href="https://solar4car.com/subscriptions" Target="_blank">https://solar4car.com/subscriptions</MudLink>
                        </MudAlert>
                        <RightAlignedButtonComponent OnButtonClicked="RecheckBaseAppLicense"
                                                     ButtonText="@T(TranslationKeys.SetupBaseAppLicenseRecheckButton)"
                                                     IsLoading="@_isRecheckingLicense" />
                    }
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepSolarBattery)">
                    <MudText GutterBottom="true">@T(TranslationKeys.SetupSolarBatteryDescription)</MudText>

                    <div class="mt-4">
                        <MudSwitch T="bool" @bind-Value="_hasPvSystem" Label="@T(TranslationKeys.SetupHasPvSystemQuestion)" Color="Color.Primary" />
                    </div>

                    @if (_hasPvSystem)
                    {
                        <TemplateValueConfigurationComponent ShowHeading="false" />

                        <MudExpansionPanels Class="mt-4">
                            <MudExpansionPanel Text="@T(TranslationKeys.SetupPvNotAvailableAsTemplate)">
                                <RestValueConfigurationComponent />
                                <ModbusValueConfigurationComponent />
                                <MqttValueConfigurationComponent />
                            </MudExpansionPanel>
                        </MudExpansionPanels>

                        <div class="mt-4">
                            <GenericInput For="() => _dtoBaseConfiguration.Item.PredictSolarPowerGeneration"></GenericInput>
                        </div>

                        <div class="mt-8">
                            <MudSwitch T="bool" @bind-Value="_hasHomeBattery" Label="@T(TranslationKeys.SetupHasHomeBatteryQuestion)" Color="Color.Primary" />
                        </div>

                        @if (_hasHomeBattery)
                        {
                            <div class="mt-4 p-4 rounded border">
                                <MudText Typo="Typo.h6" GutterBottom="true">@T(TranslationKeys.SetupHomeBatterySettingsTitle)</MudText>
                                <div class="row">
                                    <div class="col-md-6">
                                        <GenericInput T="bool?"
                                                      For="() => _dtoBaseConfiguration.Item.DynamicHomeBatteryMinSoc"
                                                      OnValueChanged="StateHasChanged"/>
                                    </div>
                                    <div class="col-md-6">
                                        <GenericInput For="() => _dtoBaseConfiguration.Item.HomeBatteryMinSoc"
                                                      IsDisabledParameter="@(_dtoBaseConfiguration.Item.DynamicHomeBatteryMinSoc)"/>
                                    </div>
                                </div>
                                <GenericInput For="() => _dtoBaseConfiguration.Item.HomeBatteryUsableEnergy" />
                                <GenericInput For="() => _dtoBaseConfiguration.Item.HomeBatteryChargingPower" />
                                <GenericInput For="() => _dtoBaseConfiguration.Item.HomeBatteryDischargingPower" />
                            </div>
                        }
                    }
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepLocation)">
                    <MudText GutterBottom="true">@T(TranslationKeys.SetupLocationDescription)</MudText>

                    <div class="mb-3">
                        <MapComponent Longitude="_dtoBaseConfiguration.Item.HomeGeofenceLongitude"
                                      Latitude="_dtoBaseConfiguration.Item.HomeGeofenceLatitude"
                                      Radius="_dtoBaseConfiguration.Item.HomeGeofenceRadius"
                                      LatitudeChanged="@(newLatitude => _dtoBaseConfiguration.Item.HomeGeofenceLatitude = newLatitude)"
                                      LongitudeChanged="@(newLongitude => _dtoBaseConfiguration.Item.HomeGeofenceLongitude = newLongitude)"></MapComponent>
                    </div>

                    <GenericInput For="() => _dtoBaseConfiguration.Item.HomeGeofenceRadius" />
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepPrices)">
                    <MudText GutterBottom="true">@T(TranslationKeys.SetupPricesDescription)</MudText>

                    <ChargePriceEditComponent ChargePrice="_chargePrice"
                                              FixedPrices="_fixedPrices"
                                              HideSubmitButton="true"
                                              ShowValidSince="false" />
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepChargingStations)">
                    <CarControlCapabilityComponent Class="mb-4" />

                    <MudAlert Severity="Severity.Info" NoIcon="true" ContentAlignment="HorizontalAlignment.Left" Class="mb-4">
                        <h5>@T(TranslationKeys.ChargingStationsHowToConnectTitle)</h5>
                        <div>@T(TranslationKeys.ChargingStationsHowToConnectContent)</div>
                        <div>@((MarkupString)T(TranslationKeys.ChargingStationsHowToConnectUrlFormat))</div>
                    </MudAlert>

                    <MudText GutterBottom="true">@T(TranslationKeys.SetupChargingStationsDescription)</MudText>

                    @if (_chargingStations == null)
                    {
                        <PlaceholderComponent Count="2"></PlaceholderComponent>
                    }
                    else if (_chargingStations.Count == 0)
                    {
                        <MudText Typo="Typo.body1" Class="mt-4 italic">@T(TranslationKeys.SetupNoStationsConnected)</MudText>
                    }
                    else
                    {
                        <MudGrid>
                            @foreach (var chargingStation in _chargingStations)
                            {
                                <MudItem xs="12" md="6">
                                    <ChargingStationOverviewComponent ChargingStation="chargingStation"
                                                                      ConnectorsCount="@(_connectorCounts.GetValueOrDefault(chargingStation.Id))"
                                                                      OnEditRequested="() => EditStation(chargingStation)"
                                                                      OnDeleteRequested="() => DeleteStation(chargingStation)" />
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepCars)">
                    <CarManagementComponent ReturnPage="setup" />
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepFinish)">
                    <MudText>@T(TranslationKeys.SetupFinishDescription)</MudText>

                    <MudAlert Severity="Severity.Success" Class="mt-8">
                        @T(TranslationKeys.SetupSuccessInfo)
                    </MudAlert>
                </MudStep>
            </ChildContent>
            <ActionContent>
                <div class="d-flex justify-space-between align-center w-100 mt-4">
                    <MudButton Disabled="@(_activeStepIndex == 0)"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => context.PreviousStepAsync())">
                        @T(TranslationKeys.GeneralPrev)
                    </MudButton>
                    @if (context.Steps.Count > 0 && _activeStepIndex >= context.Steps.Count - 1)
                    {
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   EndIcon="@Icons.Material.Filled.Check"
                                   OnClick="FinishSetup">
                            @T(TranslationKeys.SetupFinishButton)
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   Disabled="@(_activeStepIndex == CloudConnectionStepIndex && !CloudStepFulfilled)"
                                   OnClick="@(() => context.NextStepAsync())">
                            @T(TranslationKeys.GeneralNext)
                        </MudButton>
                    }
                </div>
            </ActionContent>
        </MudStepper>
    }
</MudContainer>

@code {
    private EditableItem<DtoBaseConfiguration>? _dtoBaseConfiguration;
    private EditableItem<DtoChargePrice>? _chargePrice;
    private List<FixedPrice> _fixedPrices = new();
    private List<DtoChargingStation>? _chargingStations;
    private Dictionary<int, int> _connectorCounts = new();

    private MudStepper? _stepper;
    private ChargingStationDeletionOverlay? _stationDeletionOverlay;
    private bool _hasPvSystem = true;
    private bool _hasHomeBattery;
    // Whether the instance is connected to the Solar4Car cloud and the account has a base license. Both are
    // required to use TeslaSolarCharger, so navigation past the cloud step is gated on them.
    private bool _cloudConnected;
    private bool _baseAppLicensed;
    private bool _isRecheckingLicense;
    // Bound to the stepper's ActiveIndex, so a value restored from the setup cache is applied as soon as the
    // stepper initializes. The stepper clamps it to the actual step count itself.
    private int _activeStepIndex;
    // Steps completed before a reload. Applied to the stepper once after it is rendered (see OnAfterRenderAsync).
    private List<int> _completedStepIndexes = new();
    private bool _completedStepsApplied;
    private CancellationTokenSource? _stationRefreshCts;

    // Index of the cloud connection step in the stepper. Used to gate the Next button on that step.
    private const int CloudConnectionStepIndex = 1;
    // Index of the charging stations step. The station list is only polled while this step is active so we do
    // not hammer the server (one request per station every few seconds) for the whole setup session.
    private const int ChargingStationsStepIndex = 5;

    protected override async Task OnInitializedAsync()
    {
        var cachedData = await SetupService.GetSetupCache();

        if (cachedData != null)
        {
            _dtoBaseConfiguration = new(cachedData.Configuration);
            _hasPvSystem = cachedData.HasPvSystem;
            _hasHomeBattery = cachedData.HasHomeBattery;
            _activeStepIndex = cachedData.CurrentStep;
            _completedStepIndexes = cachedData.CompletedSteps;

            // Restore the in-progress charge price from the cache so edits survive a reload. The price is only
            // persisted to the server on Finish, so without this the prices step would reset to defaults.
            if (cachedData.ChargePrice != null)
            {
                _chargePrice = new(cachedData.ChargePrice);
                _fixedPrices = cachedData.FixedPrices;
            }
        }
        else
        {
            var response = await HttpClientHelper.SendGetRequestWithSnackbarAsync<DtoBaseConfiguration>("/api/BaseConfiguration/GetBaseConfiguration");
            if (response != default)
            {
                _dtoBaseConfiguration = new(response);

                var templates = await TemplateService.GetOverviews();
                _hasPvSystem = response.PredictSolarPowerGeneration ||
                               !string.IsNullOrEmpty(response.CurrentPowerToGridUrl) ||
                               !string.IsNullOrEmpty(response.CurrentPowerToGridMqttTopic) ||
                               response.IsModbusGridUrl ||
                               (templates != null && templates.Any());

                _hasHomeBattery = response.HomeBatteryUsableEnergy > 0 ||
                                 !string.IsNullOrEmpty(response.HomeBatteryPowerUrl) ||
                                 !string.IsNullOrEmpty(response.HomeBatteryPowerMqttTopic);
            }
        }

        // Only load the price from the server when it was not already restored from the cache above.
        if (_chargePrice == null)
        {
            await LoadChargePrice();
        }

        // The CloudConnectionLoginComponent only reports the connection state while the cloud step is rendered,
        // so determine the initial state here to gate step navigation independently of the active step.
        _cloudConnected = await CloudConnectionCheckService.GetBackendTokenState(true) == TokenState.UpToDate;
        _baseAppLicensed = _cloudConnected && await CloudConnectionCheckService.IsBaseAppLicensed(true);

        _stationRefreshCts = new CancellationTokenSource();
        _ = RefreshStationsLoop(_stationRefreshCts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Not gated on firstRender: OnInitializedAsync is async, so the first render shows the loading spinner
        // and the stepper (with its @ref) only exists on a later render. Apply the completed ticks restored from
        // the cache as soon as the stepper is available; _completedStepsApplied ensures this happens exactly once.
        if (_completedStepsApplied || _stepper == null)
        {
            return;
        }

        _completedStepsApplied = true;
        foreach (var stepIndex in _completedStepIndexes.Where(i => i >= 0 && i < _stepper.Steps.Count))
        {
            await _stepper.Steps[stepIndex].SetCompletedAsync(true);
        }
    }

    private bool CloudStepFulfilled => _cloudConnected && _baseAppLicensed;

    private async Task OnCloudConnectionStateChanged(TokenState state)
    {
        _cloudConnected = state == TokenState.UpToDate;
        // The server clears its license cache on a fresh login, so the cached check is still accurate here.
        _baseAppLicensed = _cloudConnected && await CloudConnectionCheckService.IsBaseAppLicensed(true);
    }

    private async Task RecheckBaseAppLicense()
    {
        _isRecheckingLicense = true;
        // Skip the cache so a license bought on solar4car.com since the last check is detected.
        _baseAppLicensed = await CloudConnectionCheckService.IsBaseAppLicensed(false);
        _isRecheckingLicense = false;
    }

    private Task OnStepPreviewInteraction(StepperInteractionEventArgs args)
    {
        // Block any navigation past the cloud connection step (Next button as well as clicking a step header)
        // until the instance is connected and has a base license. Completing or skipping a step moves to the
        // step after it, while activating (header click) moves to the step itself.
        var targetStepIndex = args.Action == StepAction.Activate ? args.StepIndex : args.StepIndex + 1;
        if (!CloudStepFulfilled && targetStepIndex > CloudConnectionStepIndex)
        {
            args.Cancel = true;
            var notificationKey = _cloudConnected
                ? TranslationKeys.SetupBaseAppLicenseRequiredNotification
                : TranslationKeys.SetupCloudConnectionRequiredNotification;
            Snackbar.Add(T(notificationKey), Severity.Warning);
        }

        return Task.CompletedTask;
    }

    private async Task EditStation(DtoChargingStation station)
    {
        var parameters = new DialogParameters<ChargingStationEditDialog>
        {
            { x => x.ChargingStation, station }
        };

        var dialog = await DialogService.ShowAsync<ChargingStationEditDialog>(T(TranslationKeys.ChargingStationsEditStationTitle), parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await RefreshStationData();
        }
    }

    private async Task DeleteStation(DtoChargingStation station)
    {
        var parameters = new DialogParameters<DeleteDialog>
        {
            { x => x.ElementName, station.ChargepointId }
        };

        var dialog = await DialogService.ShowAsync<DeleteDialog>(T(TranslationKeys.ChargingStationsDeleteStationTitle), parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            if (_stationDeletionOverlay != null)
            {
                await _stationDeletionOverlay.DeleteAndTrackAsync(station.Id);
            }
            await RefreshStationData();
        }
    }

    private async Task LoadChargePrice()
    {
        var prices = await HttpClientHelper.SendGetRequestWithSnackbarAsync<List<DtoChargePrice>>("api/ChargingCost/GetChargePrices");
        var latestValid = prices?.Where(p => p.ValidSince <= DateTimeProvider.Now()).OrderByDescending(p => p.ValidSince).FirstOrDefault();

        if (latestValid != null)
        {
            _chargePrice = new(latestValid);
            _fixedPrices = !string.IsNullOrEmpty(latestValid.EnergyProviderConfiguration)
                ? JsonConvert.DeserializeObject<List<FixedPrice>>(latestValid.EnergyProviderConfiguration) ?? new()
                : new();
        }
        else
        {
            _chargePrice = new(new DtoChargePrice()
            {
                ValidSince = DateTimeProvider.Now(),
                GridPrice = new decimal(0.285),
                SolarPrice = new decimal(0.12),
            });
        }
    }

    private async Task RefreshStationsLoop(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                // Only poll while the user is on the charging stations step; on every other step the station
                // list is not shown, so refreshing it just wastes requests and re-renders.
                if (_activeStepIndex == ChargingStationsStepIndex)
                {
                    await RefreshStationData();
                    await InvokeAsync(StateHasChanged);
                }
                await Task.Delay(3000, ct);
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch { /* Ignore errors in background loop */ }
        }
    }

    private async Task RefreshStationData()
    {
        _chargingStations = await ChargingStationsService.GetChargingStations();
        if (_chargingStations != null)
        {
            foreach (var station in _chargingStations)
            {
                var connectors = await ChargingStationsService.GetChargingStationConnectors(station.Id);
                _connectorCounts[station.Id] = connectors?.Count ?? 0;
            }
        }
    }

    private async Task OnStepChanged(int stepIndex)
    {
        _activeStepIndex = stepIndex;

        // Load the station list right away when entering the charging stations step instead of waiting for the
        // next poll tick.
        if (stepIndex == ChargingStationsStepIndex)
        {
            await RefreshStationData();
        }

        if (_dtoBaseConfiguration == null) return;

        // Reflect the new step in the action bar immediately, without waiting for the cache update.
        StateHasChanged();

        var cache = new DtoSetupCache
        {
            CurrentStep = stepIndex,
            CompletedSteps = GetCompletedStepIndexes(),
            HasPvSystem = _hasPvSystem,
            HasHomeBattery = _hasHomeBattery,
            Configuration = _dtoBaseConfiguration.Item,
            // Snapshot the in-progress price too, so navigating between steps and reloading keeps the edits.
            ChargePrice = _chargePrice?.Item,
            FixedPrices = _fixedPrices,
        };

        await SetupService.UpdateSetupCache(cache);
    }

    private List<int> GetCompletedStepIndexes()
    {
        if (_stepper == null) return new();

        return _stepper.Steps
            .Select((step, index) => (step.Completed, index))
            .Where(x => x.Completed)
            .Select(x => x.index)
            .ToList();
    }

    private async Task FinishSetup()
    {
        if (_dtoBaseConfiguration == null || _chargePrice == null) return;

        _dtoBaseConfiguration.Item.IsFirstRun = false;

        var baseConfigResult = await HttpClientHelper.SendPostRequestAsync("api/BaseConfiguration/UpdateBaseConfiguration", _dtoBaseConfiguration.Item);
        if (baseConfigResult.HasError)
        {
            Snackbar.Add(baseConfigResult.ErrorMessage ?? "EmptyErrorMessage", Severity.Error);
            return;
        }

        // Save the charge price directly via the service. The ChargePriceEditComponent only
        // exists while the prices step is the active step, so we must not depend on its @ref here.
        _chargePrice.Item.EnergyProviderConfiguration = JsonConvert.SerializeObject(_fixedPrices);
        await ChargePriceService.UpdateChargePrice(_chargePrice.Item);

        await SetupService.DeleteSetupCache();
        _stationRefreshCts?.Cancel();
        Snackbar.Add(T(TranslationKeys.SetupSuccessNotification), Severity.Success);
        NavigationManager.NavigateTo("/", true);
    }

    private string T(string key) =>
        TextLocalizer.Get(key, typeof(SetupPageLocalizationRegistry), typeof(BaseConfigurationPageLocalizationRegistry), typeof(ChargingStationsPageLocalizationRegistry), typeof(CarSettingsPageLocalizationRegistry), typeof(SharedComponentLocalizationRegistry))
        ?? key;

    public void Dispose()
    {
        _stationRefreshCts?.Cancel();
        _stationRefreshCts?.Dispose();
    }
}
