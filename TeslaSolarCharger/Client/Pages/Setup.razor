@page "/setup"
@implements IDisposable
@using TeslaSolarCharger.Client.Components.BaseConfiguration.ValueSources.Templates
@using TeslaSolarCharger.Client.Components.BaseConfiguration.ValueSources.Rest
@using TeslaSolarCharger.Client.Components.BaseConfiguration.ValueSources.Modbus
@using TeslaSolarCharger.Client.Components.BaseConfiguration.ValueSources.Mqtt
@using TeslaSolarCharger.Client.Helper.Contracts
@using TeslaSolarCharger.Client.Services.Contracts
@using TeslaSolarCharger.Client.Wrapper
@using TeslaSolarCharger.Shared.Contracts
@using TeslaSolarCharger.Shared.Dtos.BaseConfiguration
@using TeslaSolarCharger.Shared.Dtos.Setup
@using TeslaSolarCharger.Shared.Localization
@using TeslaSolarCharger.Shared.Localization.Contracts
@using TeslaSolarCharger.Shared.Localization.Registries
@using TeslaSolarCharger.Shared.Localization.Registries.Pages
@using TeslaSolarCharger.Shared.Dtos.ChargingCost
@using TeslaSolarCharger.Shared.Dtos.ChargingStation
@using TeslaSolarCharger.Shared.Enums
@using Newtonsoft.Json
@using TeslaSolarCharger.Shared.Dtos.ChargingCost.CostConfigurations
@using TeslaSolarCharger.Client.Dialogs

@inject IHttpClientHelper HttpClientHelper
@inject ISetupService SetupService
@inject ITextLocalizationService TextLocalizer
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject ITemplateValueConfigurationService TemplateService
@inject IChargingStationsService ChargingStationsService
@inject ICloudConnectionCheckService CloudConnectionCheckService
@inject IDateTimeProvider DateTimeProvider
@inject IDialogService DialogService

<PageTitle>@T(TranslationKeys.SetupAssistantTitle)</PageTitle>

<ChargingStationDeletionOverlay @ref="_stationDeletionOverlay" />

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true">@T(TranslationKeys.SetupAssistantTitle)</MudText>

    @if (_setupState == null || _dtoBaseConfiguration == null)
    {
        <LoadingSpinnerComponent />
    }
    else
    {
        <MudStepper @ref="_stepper"
                    NonLinear="true"
                    CenterLabels="true"
                    ActiveIndex="_activeStepIndex"
                    ActiveIndexChanged="OnStepChanged"
                    OnPreviewInteraction="OnStepPreviewInteraction"
                    CurrentStepColor="Color.Primary"
                    CompletedStepColor="Color.Success">
            <ChildContent>
                <MudStep Title="@T(TranslationKeys.SetupStepWelcome)">
                    <MudText>@T(TranslationKeys.SetupWelcomeDescription)</MudText>
                    <MudAlert Severity="Severity.Info" Class="mt-4">
                        @T(TranslationKeys.SetupChangeLaterInfo)
                    </MudAlert>
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepCloudConnection)">
                    <MudText GutterBottom="true">@T(TranslationKeys.SetupCloudConnectionDescription)</MudText>

                    <div class="mt-4">
                        <CloudConnectionLoginComponent OnConnectionStateChanged="OnCloudConnectionStateChanged" />
                    </div>

                    @if (_cloudConnected && !_baseAppLicensed)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-4">
                            <div>@T(TranslationKeys.SetupBaseAppLicenseMissingInfo)</div>
                            <MudLink Href="https://solar4car.com/subscriptions" Target="_blank">https://solar4car.com/subscriptions</MudLink>
                        </MudAlert>
                        <RightAlignedButtonComponent OnButtonClicked="RecheckBaseAppLicense"
                                                     ButtonText="@T(TranslationKeys.SetupBaseAppLicenseRecheckButton)"
                                                     IsLoading="@_isRecheckingLicense" />
                    }
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepSolarBattery)">
                    <MudText GutterBottom="true">@T(TranslationKeys.SetupSolarBatteryDescription)</MudText>

                    <div class="mt-4">
                        <MudSwitch T="bool" Value="_hasPvSystem" ValueChanged="OnHasPvSystemChanged" Label="@T(TranslationKeys.SetupHasPvSystemQuestion)" Color="Color.Primary" />
                    </div>

                    @if (_hasPvSystem)
                    {
                        <TemplateValueConfigurationComponent ShowHeading="false" />

                        <MudExpansionPanels Class="mt-4">
                            <MudExpansionPanel Text="@T(TranslationKeys.SetupPvNotAvailableAsTemplate)">
                                <RestValueConfigurationComponent />
                                <ModbusValueConfigurationComponent />
                                <MqttValueConfigurationComponent />
                            </MudExpansionPanel>
                        </MudExpansionPanels>

                        <div class="mt-4">
                            <GenericInput For="() => _dtoBaseConfiguration.Item.PredictSolarPowerGeneration"
                                          OnValueChanged="@((bool _) => MarkAsUserEntered(nameof(BaseConfigurationBase.PredictSolarPowerGeneration)))"></GenericInput>
                        </div>
                    }

                    @* Asked independently of the solar question: a home battery is worth managing even without panels. *@
                    <div class="mt-8">
                        <MudSwitch T="bool" Value="_hasHomeBattery" ValueChanged="OnHasHomeBatteryChanged" Label="@T(TranslationKeys.SetupHasHomeBatteryQuestion)" Color="Color.Primary" />
                    </div>

                    @if (_hasHomeBattery)
                    {
                        <div class="mt-4 p-4 rounded border">
                            <MudText Typo="Typo.h6" GutterBottom="true">@T(TranslationKeys.SetupHomeBatterySettingsTitle)</MudText>
                            <div class="row">
                                <div class="col-md-6">
                                    <GenericInput T="bool?"
                                                  For="() => _dtoBaseConfiguration.Item.DynamicHomeBatteryMinSoc"
                                                  OnValueChanged="OnDynamicHomeBatteryMinSocChanged"/>
                                </div>
                                <div class="col-md-6">
                                    <GenericInput For="() => _dtoBaseConfiguration.Item.HomeBatteryMinSoc"
                                                  IsDisabledParameter="@(_dtoBaseConfiguration.Item.DynamicHomeBatteryMinSoc)"/>
                                </div>
                            </div>
                            <GenericInput For="() => _dtoBaseConfiguration.Item.HomeBatteryUsableEnergy" />
                            <GenericInput For="() => _dtoBaseConfiguration.Item.HomeBatteryChargingPower" />
                            <GenericInput For="() => _dtoBaseConfiguration.Item.HomeBatteryDischargingPower" />
                        </div>
                    }
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepLocation)">
                    <MudText GutterBottom="true">@T(TranslationKeys.SetupLocationDescription)</MudText>

                    <div class="mb-3">
                        <MapComponent Longitude="_dtoBaseConfiguration.Item.HomeGeofenceLongitude"
                                      Latitude="_dtoBaseConfiguration.Item.HomeGeofenceLatitude"
                                      Radius="_dtoBaseConfiguration.Item.HomeGeofenceRadius"
                                      LatitudeChanged="OnHomeLatitudeChanged"
                                      LongitudeChanged="OnHomeLongitudeChanged"></MapComponent>
                    </div>

                    <GenericInput For="() => _dtoBaseConfiguration.Item.HomeGeofenceRadius" />
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepPrices)">
                    <MudText GutterBottom="true">@T(TranslationKeys.SetupPricesDescription)</MudText>

                    <ChargePriceEditComponent ChargePrice="_chargePrice"
                                              FixedPrices="_fixedPrices"
                                              HideSubmitButton="true"
                                              ShowValidSince="false" />
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepCarsAndCharging)">
                    <CarChargingSetupComponent Answers="_setupState.CarsChargingSetup" OnAnswersChanged="PersistSetupState" />

                    <MudDivider Class="my-6" />
                    <MudText Typo="Typo.h6" GutterBottom="true">@T(TranslationKeys.SetupStepChargingStations)</MudText>

                    <MudAlert Severity="Severity.Info" NoIcon="true" ContentAlignment="HorizontalAlignment.Left" Class="mb-4">
                        <h5>@T(TranslationKeys.ChargingStationsHowToConnectTitle)</h5>
                        <div>@T(TranslationKeys.ChargingStationsHowToConnectContent)</div>
                        <div>@((MarkupString)T(TranslationKeys.ChargingStationsHowToConnectUrlFormat))</div>
                    </MudAlert>

                    <MudText GutterBottom="true">@T(TranslationKeys.SetupChargingStationsDescription)</MudText>

                    @if (_chargingStations == null)
                    {
                        <PlaceholderComponent Count="2"></PlaceholderComponent>
                    }
                    else if (_chargingStations.Count == 0)
                    {
                        <MudText Typo="Typo.body1" Class="mt-4 italic">@T(TranslationKeys.SetupNoStationsConnected)</MudText>
                    }
                    else
                    {
                        <MudGrid>
                            @foreach (var chargingStation in _chargingStations)
                            {
                                <MudItem xs="12" md="6">
                                    <ChargingStationOverviewComponent ChargingStation="chargingStation"
                                                                      ConnectorsCount="@(_connectorCounts.GetValueOrDefault(chargingStation.Id))"
                                                                      OnEditRequested="() => EditStation(chargingStation)"
                                                                      OnDeleteRequested="() => DeleteStation(chargingStation)" />
                                </MudItem>
                            }
                        </MudGrid>
                    }

                    <MudDivider Class="my-6" />
                    <MudText Typo="Typo.h6" GutterBottom="true">@T(TranslationKeys.SetupStepCars)</MudText>

                    <CarManagementComponent ReturnPage="setup" ShowControlCapabilityInfo="false" />
                </MudStep>

                <MudStep Title="@T(TranslationKeys.SetupStepFinish)">
                    <MudText>@T(TranslationKeys.SetupFinishDescription)</MudText>

                    @if (_isEvaluating)
                    {
                        <LoadingSpinnerComponent />
                    }
                    else if (_decision != null)
                    {
                        @if (_decision.NextAction != null && !_decision.IsConfigurationComplete)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-4" ContentAlignment="HorizontalAlignment.Left">
                                <MudText Typo="Typo.subtitle2" Style="font-weight: bold">@T(TranslationKeys.SetupNextActionHeading)</MudText>
                                <MudText Typo="Typo.body2">@T(_decision.NextAction.DescriptionKey)</MudText>
                            </MudAlert>
                        }

                        @if (_decision.Incompatibilities.Count > 0)
                        {
                            <MudAlert Severity="Severity.Error" Class="mt-4" ContentAlignment="HorizontalAlignment.Left">
                                <MudText Typo="Typo.subtitle2" Style="font-weight: bold">@T(TranslationKeys.SetupIncompatibilitiesHeading)</MudText>
                                <ul class="mb-0">
                                    @foreach (var issue in _decision.Incompatibilities)
                                    {
                                        <li>@T(issue.MessageKey)</li>
                                    }
                                </ul>
                            </MudAlert>
                        }

                        @if (_decision.MissingInformation.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-4" ContentAlignment="HorizontalAlignment.Left">
                                <MudText Typo="Typo.subtitle2" Style="font-weight: bold">@T(TranslationKeys.SetupMissingInformationHeading)</MudText>
                                <ul class="mb-0">
                                    @foreach (var issue in _decision.MissingInformation)
                                    {
                                        <li>@T(issue.MessageKey)</li>
                                    }
                                </ul>
                                <MudText Typo="Typo.body2" Class="mt-2">@T(TranslationKeys.SetupConfigurationIncompleteInfo)</MudText>
                            </MudAlert>
                        }

                        @if (_decision.ProposedValues.Count > 0)
                        {
                            <div class="mt-4 p-4 rounded border">
                                <MudText Typo="Typo.subtitle1" Style="font-weight: bold" GutterBottom="true">@T(TranslationKeys.SetupProposalsHeading)</MudText>
                                @foreach (var proposal in _decision.ProposedValues)
                                {
                                    <div class="d-flex align-start" style="gap: 8px;">
                                        <MudCheckBox T="bool"
                                                     Value="@(!_declinedProposals.Contains(ProposalId(proposal)))"
                                                     ValueChanged="@(accepted => ToggleProposal(proposal, accepted))"
                                                     Color="Color.Primary"
                                                     Dense="true" />
                                        <div>
                                            <MudText Typo="Typo.body2">@T(proposal.ReasonKey)</MudText>
                                            @if (proposal.IsPending)
                                            {
                                                <MudText Typo="Typo.caption">
                                                    @T(TranslationKeys.SetupProposalPendingPrefix)
                                                    @string.Join(" ", proposal.PendingReasons.Select(r => T(r.MessageKey)))
                                                </MudText>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }

                    <MudAlert Severity="Severity.Success" Class="mt-8">
                        @T(TranslationKeys.SetupEnableExplanation)
                    </MudAlert>

                    <div class="mt-4">
                        <MudButton Variant="Variant.Outlined"
                                   OnClick="SaveWithoutEnabling"
                                   Disabled="_isSaving">
                            @T(TranslationKeys.SetupSaveWithoutEnablingButton)
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="mt-1">@T(TranslationKeys.SetupSaveWithoutEnablingHint)</MudText>
                    </div>
                </MudStep>
            </ChildContent>
            <ActionContent>
                <div class="d-flex justify-space-between align-center w-100 mt-4">
                    <MudButton Disabled="@(_activeStepIndex == 0)"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => context.PreviousStepAsync())">
                        @T(TranslationKeys.GeneralPrev)
                    </MudButton>
                    @if (context.Steps.Count > 0 && _activeStepIndex >= context.Steps.Count - 1)
                    {
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   EndIcon="@Icons.Material.Filled.Check"
                                   Disabled="_isSaving"
                                   OnClick="FinishSetup">
                            @T(TranslationKeys.SetupFinishButton)
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   Disabled="@(CurrentStepKey == SetupStepKey.CloudConnection && !CloudStepFulfilled)"
                                   OnClick="@(() => context.NextStepAsync())">
                            @T(TranslationKeys.GeneralNext)
                        </MudButton>
                    }
                </div>
            </ActionContent>
        </MudStepper>
    }
</MudContainer>

@code {
    /// <summary>
    /// The stepper's steps in the order they are declared above. The persisted state stores the stable key, so a
    /// step can be inserted or reordered here without sending a returning user to the wrong screen.
    /// </summary>
    private static readonly SetupStepKey[] StepOrder =
    [
        SetupStepKey.Welcome,
        SetupStepKey.CloudConnection,
        SetupStepKey.SolarAndBattery,
        SetupStepKey.Location,
        SetupStepKey.Prices,
        SetupStepKey.CarsAndCharging,
        SetupStepKey.Finish,
    ];

    private DtoSetupState? _setupState;
    private DtoSetupDecision? _decision;

    // Wraps the very object held by the setup state, so every edit made through the inputs below is already part of
    // what gets persisted; no copying back and forth.
    private EditableItem<DtoBaseConfiguration>? _dtoBaseConfiguration;
    private EditableItem<DtoChargePrice>? _chargePrice;
    private List<FixedPrice> _fixedPrices = new();
    private List<DtoChargingStation>? _chargingStations;
    private Dictionary<int, int> _connectorCounts = new();

    private MudStepper? _stepper;
    private ChargingStationDeletionOverlay? _stationDeletionOverlay;
    private bool _hasPvSystem = true;
    private bool _hasHomeBattery;
    // Whether the instance is connected to the Solar4Car cloud and the account has a base license. Both are
    // required to use TeslaSolarCharger, so navigation past the cloud step is gated on them.
    private bool _cloudConnected;
    private bool _baseAppLicensed;
    private bool _isRecheckingLicense;
    private bool _isEvaluating;
    private bool _isSaving;
    // Proposals the user unticked. Everything the decision service proposes is accepted unless it appears here, so
    // a newly proposed setting is opt-out rather than something to hunt for.
    private readonly HashSet<string> _declinedProposals = new();
    // Bound to the stepper's ActiveIndex, so a step restored from the persisted state is applied as soon as the
    // stepper initializes. The stepper clamps it to the actual step count itself.
    private int _activeStepIndex;
    // Steps completed before a reload. Applied to the stepper once after it is rendered (see OnAfterRenderAsync).
    private List<int> _completedStepIndexes = new();
    private bool _completedStepsApplied;
    private CancellationTokenSource? _stationRefreshCts;

    private SetupStepKey CurrentStepKey => StepKeyForIndex(_activeStepIndex);

    protected override async Task OnInitializedAsync()
    {
        // The server seeds a fresh state from what is already configured, so an existing installation starts from
        // its real settings instead of from defaults.
        _setupState = await SetupService.GetOrCreateSetupState() ?? new DtoSetupState();
        _dtoBaseConfiguration = new(_setupState.Configuration);

        _activeStepIndex = IndexForStepKey(_setupState.CurrentStep);
        _completedStepIndexes = _setupState.CompletedSteps.Select(IndexForStepKey).Where(i => i >= 0).ToList();

        await InitializeEquipmentAnswers();

        if (_setupState.ChargePrice != null)
        {
            _chargePrice = new(_setupState.ChargePrice);
            _fixedPrices = _setupState.FixedPrices;
        }
        else
        {
            await LoadChargePrice();
        }

        // The CloudConnectionLoginComponent only reports the connection state while the cloud step is rendered,
        // so determine the initial state here to gate step navigation independently of the active step.
        _cloudConnected = await CloudConnectionCheckService.GetBackendTokenState(true) == TokenState.UpToDate;
        _baseAppLicensed = _cloudConnected && await CloudConnectionCheckService.IsBaseAppLicensed(true);

        // Someone who left on the review step comes back to it, so the review has to be there without them
        // navigating away and back first.
        if (CurrentStepKey == SetupStepKey.Finish)
        {
            await EvaluateSetup();
        }

        _stationRefreshCts = new CancellationTokenSource();
        _ = RefreshStationsLoop(_stationRefreshCts.Token);
    }

    /// <summary>
    /// Fills the solar and battery switches. An answer already stored wins; otherwise it is derived from what the
    /// installation has configured, which is a better starting point than a blank form.
    /// </summary>
    private async Task InitializeEquipmentAnswers()
    {
        if (_setupState == null)
        {
            return;
        }

        if (_setupState.HasPvSystem != null)
        {
            _hasPvSystem = _setupState.HasPvSystem.Value;
        }
        else
        {
            var configuration = _setupState.Configuration;
            var templates = await TemplateService.GetOverviews();
            _hasPvSystem = configuration.PredictSolarPowerGeneration
                           || !string.IsNullOrEmpty(configuration.CurrentPowerToGridUrl)
                           || !string.IsNullOrEmpty(configuration.CurrentPowerToGridMqttTopic)
                           || configuration.IsModbusGridUrl
                           || (templates != null && templates.Any());
        }

        if (_setupState.HasHomeBattery != null)
        {
            _hasHomeBattery = _setupState.HasHomeBattery.Value;
        }
        else
        {
            var configuration = _setupState.Configuration;
            _hasHomeBattery = configuration.HomeBatteryUsableEnergy > 0
                              || !string.IsNullOrEmpty(configuration.HomeBatteryPowerUrl)
                              || !string.IsNullOrEmpty(configuration.HomeBatteryPowerMqttTopic);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Not gated on firstRender: OnInitializedAsync is async, so the first render shows the loading spinner
        // and the stepper (with its @ref) only exists on a later render. Apply the completed ticks restored from
        // the state as soon as the stepper is available; _completedStepsApplied ensures this happens exactly once.
        if (_completedStepsApplied || _stepper == null)
        {
            return;
        }

        _completedStepsApplied = true;
        foreach (var stepIndex in _completedStepIndexes.Where(i => i >= 0 && i < _stepper.Steps.Count))
        {
            await _stepper.Steps[stepIndex].SetCompletedAsync(true);
        }
    }

    private bool CloudStepFulfilled => _cloudConnected && _baseAppLicensed;

    private async Task OnCloudConnectionStateChanged(TokenState state)
    {
        _cloudConnected = state == TokenState.UpToDate;
        // The server clears its license cache on a fresh login, so the cached check is still accurate here.
        _baseAppLicensed = _cloudConnected && await CloudConnectionCheckService.IsBaseAppLicensed(true);
    }

    private async Task RecheckBaseAppLicense()
    {
        _isRecheckingLicense = true;
        // Skip the cache so a license bought on solar4car.com since the last check is detected.
        _baseAppLicensed = await CloudConnectionCheckService.IsBaseAppLicensed(false);
        _isRecheckingLicense = false;
    }

    private Task OnStepPreviewInteraction(StepperInteractionEventArgs args)
    {
        // Block any navigation past the cloud connection step (Next button as well as clicking a step header)
        // until the instance is connected and has a base license. Completing or skipping a step moves to the
        // step after it, while activating (header click) moves to the step itself.
        var targetStepIndex = args.Action == StepAction.Activate ? args.StepIndex : args.StepIndex + 1;
        if (!CloudStepFulfilled && targetStepIndex > IndexForStepKey(SetupStepKey.CloudConnection))
        {
            args.Cancel = true;
            var notificationKey = _cloudConnected
                ? TranslationKeys.SetupBaseAppLicenseRequiredNotification
                : TranslationKeys.SetupCloudConnectionRequiredNotification;
            Snackbar.Add(T(notificationKey), Severity.Warning);
        }

        return Task.CompletedTask;
    }

    private async Task OnHasPvSystemChanged(bool value)
    {
        _hasPvSystem = value;
        await PersistSetupState();
    }

    private async Task OnHasHomeBatteryChanged(bool value)
    {
        _hasHomeBattery = value;
        await PersistSetupState();
    }

    private async Task OnDynamicHomeBatteryMinSocChanged(bool? value)
    {
        // Deciding this by hand is an explicit choice and must survive the automatic proposal.
        MarkAsUserEntered(nameof(BaseConfigurationBase.DynamicHomeBatteryMinSoc));
        StateHasChanged();
        await PersistSetupState();
    }

    private async Task OnHomeLatitudeChanged(double latitude)
    {
        if (_dtoBaseConfiguration == null) return;
        _dtoBaseConfiguration.Item.HomeGeofenceLatitude = latitude;
        // Picking a spot on the map is what turns the preset coordinates into a confirmed address.
        MarkAsUserEntered(nameof(BaseConfigurationBase.HomeGeofenceLatitude));
        await PersistSetupState();
    }

    private async Task OnHomeLongitudeChanged(double longitude)
    {
        if (_dtoBaseConfiguration == null) return;
        _dtoBaseConfiguration.Item.HomeGeofenceLongitude = longitude;
        MarkAsUserEntered(nameof(BaseConfigurationBase.HomeGeofenceLongitude));
        await PersistSetupState();
    }

    private void MarkAsUserEntered(string propertyName)
    {
        if (_setupState == null) return;
        _setupState.ValueSources[propertyName] = SetupValueSource.UserEntered;
    }

    private async Task EditStation(DtoChargingStation station)
    {
        var parameters = new DialogParameters<ChargingStationEditDialog>
        {
            { x => x.ChargingStation, station }
        };

        var dialog = await DialogService.ShowAsync<ChargingStationEditDialog>(T(TranslationKeys.ChargingStationsEditStationTitle), parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await RefreshStationData();
        }
    }

    private async Task DeleteStation(DtoChargingStation station)
    {
        var parameters = new DialogParameters<DeleteDialog>
        {
            { x => x.ElementName, station.ChargepointId }
        };

        var dialog = await DialogService.ShowAsync<DeleteDialog>(T(TranslationKeys.ChargingStationsDeleteStationTitle), parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            if (_stationDeletionOverlay != null)
            {
                await _stationDeletionOverlay.DeleteAndTrackAsync(station.Id);
            }
            await RefreshStationData();
        }
    }

    private async Task LoadChargePrice()
    {
        var prices = await HttpClientHelper.SendGetRequestWithSnackbarAsync<List<DtoChargePrice>>("api/ChargingCost/GetChargePrices");
        var latestValid = prices?.Where(p => p.ValidSince <= DateTimeProvider.Now()).OrderByDescending(p => p.ValidSince).FirstOrDefault();

        if (latestValid != null)
        {
            _chargePrice = new(latestValid);
            _fixedPrices = !string.IsNullOrEmpty(latestValid.EnergyProviderConfiguration)
                ? JsonConvert.DeserializeObject<List<FixedPrice>>(latestValid.EnergyProviderConfiguration) ?? new()
                : new();
        }
        else
        {
            _chargePrice = new(new DtoChargePrice()
            {
                ValidSince = DateTimeProvider.Now(),
                GridPrice = new decimal(0.285),
                SolarPrice = new decimal(0.12),
            });
        }
    }

    private async Task RefreshStationsLoop(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                // Only poll while the user is on the cars & charging step; on every other step the station
                // list is not shown, so refreshing it just wastes requests and re-renders.
                if (CurrentStepKey == SetupStepKey.CarsAndCharging)
                {
                    await RefreshStationData();
                    await InvokeAsync(StateHasChanged);
                }
                await Task.Delay(3000, ct);
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch { /* Ignore errors in background loop */ }
        }
    }

    private async Task RefreshStationData()
    {
        _chargingStations = await ChargingStationsService.GetChargingStations();
        if (_chargingStations != null)
        {
            foreach (var station in _chargingStations)
            {
                var connectors = await ChargingStationsService.GetChargingStationConnectors(station.Id);
                _connectorCounts[station.Id] = connectors?.Count ?? 0;
            }
        }
    }

    private async Task OnStepChanged(int stepIndex)
    {
        _activeStepIndex = stepIndex;

        // Load the station list right away when entering the cars & charging step instead of waiting for the
        // next poll tick.
        if (CurrentStepKey == SetupStepKey.CarsAndCharging)
        {
            await RefreshStationData();
        }

        // Reflect the new step in the action bar immediately, without waiting for the save.
        StateHasChanged();

        await PersistSetupState();

        if (CurrentStepKey == SetupStepKey.Finish)
        {
            await EvaluateSetup();
        }
    }

    /// <summary>
    /// Asks the server what applies, what is missing and what it would configure on its own. Only done on the
    /// review step, where the answer is actually shown.
    /// </summary>
    private async Task EvaluateSetup()
    {
        if (_setupState == null) return;
        _isEvaluating = true;
        StateHasChanged();
        _decision = await SetupService.EvaluateSetupState(_setupState);
        _isEvaluating = false;
    }

    private void ToggleProposal(DtoSetupProposedValue proposal, bool isAccepted)
    {
        if (isAccepted)
        {
            _declinedProposals.Remove(ProposalId(proposal));
            return;
        }

        _declinedProposals.Add(ProposalId(proposal));
    }

    private static string ProposalId(DtoSetupProposedValue proposal) => $"{proposal.DraftId}|{proposal.PropertyName}";

    /// <summary>
    /// Writes the current answers to the server. Called on every meaningful change, so an interruption - a reload,
    /// an account authorization that navigates away - never costs the user their answers.
    /// </summary>
    private async Task PersistSetupState()
    {
        if (_setupState == null) return;

        _setupState.CurrentStep = CurrentStepKey;
        _setupState.CompletedSteps = GetCompletedStepKeys();
        // Only recorded once the user has actually seen the question, so an unanswered question stays unanswered
        // rather than being silently answered with whatever the switch happened to show.
        if (_setupState.CurrentStep == SetupStepKey.SolarAndBattery || _setupState.IsStepCompleted(SetupStepKey.SolarAndBattery))
        {
            _setupState.HasPvSystem = _hasPvSystem;
            _setupState.HasHomeBattery = _hasHomeBattery;
        }
        _setupState.ChargePrice = _chargePrice?.Item;
        _setupState.FixedPrices = _fixedPrices;

        await SetupService.UpdateSetupState(_setupState);
    }

    private List<SetupStepKey> GetCompletedStepKeys()
    {
        if (_stepper == null) return _setupState?.CompletedSteps ?? new List<SetupStepKey>();

        return _stepper.Steps
            .Select((step, index) => (step.Completed, index))
            .Where(x => x.Completed)
            .Select(x => StepKeyForIndex(x.index))
            .Where(k => k != SetupStepKey.Unknown)
            .ToList();
    }

    private static SetupStepKey StepKeyForIndex(int index) =>
        index >= 0 && index < StepOrder.Length ? StepOrder[index] : SetupStepKey.Unknown;

    private static int IndexForStepKey(SetupStepKey key)
    {
        var index = Array.IndexOf(StepOrder, key);
        // A key this build does not know must not leave the user on a step that is not there.
        return index < 0 ? 0 : index;
    }

    /// <summary>
    /// Saves everything without switching anything on. The state is deliberately kept, so the user can come back
    /// and enable charging when they are ready.
    /// </summary>
    private async Task SaveWithoutEnabling()
    {
        if (_setupState == null) return;
        _isSaving = true;
        try
        {
            await AcceptSelectedProposals();
            var result = await SetupService.ApplyConfiguration(_setupState);
            if (result == null || !result.IsSuccess)
            {
                ReportFailedOperations(result);
                return;
            }

            Snackbar.Add(T(TranslationKeys.SetupSavedWithoutEnablingNotification), Severity.Success);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task FinishSetup()
    {
        if (_setupState == null) return;
        _isSaving = true;
        try
        {
            await AcceptSelectedProposals();
            var result = await SetupService.ActivateAndCompleteSetup(_setupState);
            if (result is not { IsSetupCompleted: true })
            {
                // Setup is only over when the server says every required save succeeded. Until then the answers
                // stay and the user can try again.
                ReportFailedOperations(result);
                return;
            }

            _stationRefreshCts?.Cancel();
            Snackbar.Add(T(TranslationKeys.SetupSuccessNotification), Severity.Success);
            NavigationManager.NavigateTo("/", true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task AcceptSelectedProposals()
    {
        if (_setupState == null || _decision == null)
        {
            return;
        }

        var accepted = _decision.ProposedValues
            .Where(p => !_declinedProposals.Contains(ProposalId(p)))
            .ToList();
        if (accepted.Count == 0)
        {
            return;
        }

        var updatedState = await SetupService.AcceptProposals(_setupState, accepted);
        if (updatedState != null)
        {
            _setupState = updatedState;
            _dtoBaseConfiguration = new(_setupState.Configuration);
        }
    }

    private void ReportFailedOperations(DtoSetupApplicationResult? result)
    {
        Snackbar.Add(T(TranslationKeys.SetupPartialSaveFailure), Severity.Error);
        foreach (var failedOperation in result?.FailedOperations ?? Enumerable.Empty<DtoSetupOperationResult>())
        {
            Snackbar.Add($"{failedOperation.OperationKey}: {failedOperation.ErrorMessage}", Severity.Error);
        }
    }

    private string T(string key) =>
        TextLocalizer.Get(key, typeof(SetupPageLocalizationRegistry), typeof(BaseConfigurationPageLocalizationRegistry), typeof(ChargingStationsPageLocalizationRegistry), typeof(CarSettingsPageLocalizationRegistry), typeof(SharedComponentLocalizationRegistry))
        ?? key;

    public void Dispose()
    {
        _stationRefreshCts?.Cancel();
        _stationRefreshCts?.Dispose();
    }
}
