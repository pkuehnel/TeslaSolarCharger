@page "/CarSettings"
@using TeslaSolarCharger.Shared.Dtos
@using TeslaSolarCharger.Client.Wrapper
@using TeslaSolarCharger.Shared.Dtos.Ble
@using TeslaSolarCharger.Client.Helper.Contracts
@using TeslaSolarCharger.Client.Services.Contracts
@using TeslaSolarCharger.Shared.Enums
@using TeslaSolarCharger.Shared.Resources.Contracts
@using TeslaSolarCharger.Shared.Localization
@using TeslaSolarCharger.Shared.Localization.Contracts
@using TeslaSolarCharger.Shared.Localization.Registries
@using TeslaSolarCharger.Shared.Localization.Registries.Pages
@using TeslaSolarCharger.Client.Dialogs

@inject ICarSettingsService CarSettingsService
@inject IConstants Constants
@inject IJavaScriptWrapper JavaScriptWrapper
@inject ITextLocalizationService TextLocalizer
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IOAuthNotificationService OAuthNotificationService
@inject IDialogService DialogService

<PageTitle>@T(TranslationKeys.CarSettingsTitle)</PageTitle>
<h1>@T(TranslationKeys.CarSettingsTitle)</h1>

<div class="mb-3">
    @if (_fleetApiTokenState != null && _fleetApiTokenState != TokenState.UpToDate)
    {
        <MudAlert Severity="Severity.Error" NoIcon="true" ContentAlignment="HorizontalAlignment.Left">
            <h4>@T(TranslationKeys.CarSettingsCreateTokenTitle)</h4>
            @T(TranslationKeys.CarSettingsGoToPrefix)<MudLink Href="/cloudconnection">@T(TranslationKeys.CloudConnectionTitle)</MudLink>@T(TranslationKeys.CarSettingsGenerateTokenSuffix)
        </MudAlert>
    }
    
    <LicenseInfoComponent Class="mt-3" />
</div>


@if (_carBasicConfigurations == null)
{
    <LoadingSpinnerComponent />
}
else
{
    @if (_fleetApiTokenState == TokenState.UpToDate)
    {
        <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.CarSettingsAddTeslaFromAccountButton)'
                                     StartIcon="@Icons.Material.Filled.Sync"
                                     IsLoading="_isRefreshingTeslaCars"
                                     OnButtonClicked="RefreshTeslaCars"></RightAlignedButtonComponent>
    }

    <RightAlignedButtonComponent ButtonText='@T(TranslationKeys.CarSettingsAddNonTeslaButton)'
                                 StartIcon="@Icons.Material.Filled.Add"
                                 OnButtonClicked="AddNewCar"></RightAlignedButtonComponent>

    <MudGrid>
        @foreach (var carBasicConfiguration in _carBasicConfigurations)
        {
            <MudItem xs="12" md="6" xl="4">
                <CarOverviewComponent Car="carBasicConfiguration" 
                                      OnEditRequested="() => EditCar(carBasicConfiguration)" 
                                      OnDeleteRequested="() => DeleteCar(carBasicConfiguration)" />
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<EditableItem<CarBasicConfiguration>>? _carBasicConfigurations;
    private TokenState? _fleetApiTokenState;
    private bool _isRefreshingTeslaCars;
    private DtoCarLicenseInfo _carLicenseInfo = new();

    private string T(string key) =>
        TextLocalizer.Get<CarSettingsPageLocalizationRegistry>(key, typeof(SharedComponentLocalizationRegistry))
        ?? key;

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
    }

    private async Task RefreshData()
    {
        await RefreshFleetApiTokenState();
        await RefreshFleetApiLicenseInfo();
        await OAuthNotificationService.HandleQueryParameters();
        var carBasicConfigurations = await CarSettingsService.GetCarBasicConfigurations();
        if (carBasicConfigurations != null)
        {
            _carBasicConfigurations = carBasicConfigurations.Select(c => new EditableItem<CarBasicConfiguration>(c)).ToList();
        }
    }

    private async Task RefreshFleetApiLicenseInfo()
    {
        var licenseInfo = await CarSettingsService.GetFleetApiLicenseInfo();
        if (licenseInfo != null)
        {
            _carLicenseInfo = licenseInfo;
        }
    }

    private async Task RefreshFleetApiTokenState()
    {
        _fleetApiTokenState = await CarSettingsService.GetFleetApiTokenState();
    }

    private async Task RefreshTeslaCars()
    {
        _isRefreshingTeslaCars = true;
        var success = await CarSettingsService.RefreshTeslaCarsFromAccount();
        if (success)
        {
            await RefreshData();
        }
        _isRefreshingTeslaCars = false;
    }

    private async Task AddNewCar()
    {
        var newCar = new EditableItem<CarBasicConfiguration>(new CarBasicConfiguration());
        await EditCar(newCar);
    }

    private async Task EditCar(EditableItem<CarBasicConfiguration> car)
    {
        var parameters = new DialogParameters<CarEditDialog>
        {
            { x => x.Car, car },
        };

        var dialog = await DialogService.ShowAsync<CarEditDialog>(T(TranslationKeys.CarSettingsTitle), parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await RefreshData();
        }
    }

    private async Task DeleteCar(EditableItem<CarBasicConfiguration> car)
    {
        var parameters = new DialogParameters<DeleteDialog>
        {
            { x => x.ElementName, car.Item.Name },
        };

        var dialog = await DialogService.ShowAsync<DeleteDialog>(T(TranslationKeys.DeleteDialogConfirm), parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await CarSettingsService.DeleteCar(car.Item.Id);
            await RefreshData();
        }
    }
}
