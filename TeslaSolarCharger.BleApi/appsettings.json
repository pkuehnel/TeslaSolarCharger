{
  "AllowedHosts": "*",
  "PrivateKeyPath": "/externalFiles/privateKey.pem",
  "PublicKeyPath": "/externalFiles/publicKey.pem",
  "TeslaCacheFilePath": "/app/tesla-cache.json",
  "BackendApiBaseUrl": "https://www.teslasolarcharger.de/api/",
  "ProcessExecutionTimeoutSeconds": 23,
  "SemaphoreSlimWaitTimeoutSeconds": 25,
  "CommandTimeoutSeconds": 10,
  "ConnectTimeoutSeconds": 10,
  "BeaconScanTimeoutSeconds": 7,
  "ScanStreamEnabled": true,
  "ScanDigestIntervalMs": 500,
  "ScanDigestIdleIntervalSeconds": 5,
  "ScanMaxDigestDevices": 64,
  "ScanDeafAfterSeconds": 90,
  "PresenceMaxAgeSeconds": 90,
  "BleDaemonIdleTimeoutSeconds": 300,
  "BleDaemonConnectionWindowSeconds": 25,
  "WorkerReadyTimeoutSeconds": 30,
  "AdapterRestartGuardSeconds": 2,
  "ApiRole": "charging_manager",
  "InMemoryLogDefaultCapacity": 10000
}
