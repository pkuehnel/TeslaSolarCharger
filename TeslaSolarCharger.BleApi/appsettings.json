{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Enrich": [ "SourceContext" ],
      "Override": {
        "Microsoft": "Information",
        "System": "Error",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:dd-MMM-yyyy HH:mm:ss.fff} {Level:u3} {SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "PrivateKeyPath": "/externalFiles/privateKey.pem",
  "PublicKeyPath": "/externalFiles/publicKey.pem",
  "TeslaCacheFilePath": "/app/tesla-cache.json",
  "BackendApiBaseUrl": "https://www.teslasolarcharger.de/api/",
  "ProcessExecutionTimeoutSeconds": 23,
  "SemaphoreSlimWaitTimeoutSeconds": 25,
  "CommandTimeoutSeconds": 10,
  "ConnectTimeoutSeconds": 10,
  "MinimumWaitTimeBetweenCommandsMilliseconds": 1000,
  "ApiRole": "charging_manager",
  "UseDebugBle": false
}
